////////////////////////////////////////////////////////////
// Описание пакета oscript-md для сборки и установки через opm.
// Полную документацию по формату см. на hub.oscript.io/packaging.
//
// oscript-md — Markdown-парсер и рендерер на чистом OneScript:
// CommonMark + GFM-расширения (tables, tasklists, strikethrough, autolinks).
// Разбор и рендеринг реализованы без сторонних библиотек; единственная
// зависимость рантайма — html-sanitizer, её зовёт Markdown.ВБезопасныйHTML
// (рендер недоверенного Markdown с санитизацией по allowlist). Своего
// санитайзера библиотека не заводит: это отдельная предметная область
// с отдельным XSS-корпусом, и живёт она в html-sanitizer.
//
// Кроме кода на OneScript пакет везёт скрипт подсветки кода BSL для браузера —
// shiki (MIT), собранный в src/highlight/oscript-md-highlight.js. В git скрипт
// не хранится: его собирает ПередСборкой ниже, поэтому для `opm build` нужны node
// с npm в PATH. Процедуры packagedef стоят до Описание и обходятся без #Использовать:
// opm компилирует packagedef и при установке зависимостей, когда их ещё нет.
//
// РазработкаЗависитОт ниже относится только к процессу разработки
// (утверждения в тестах, обвязка над дочерними процессами в tasks/).
//
// oneunit (test-runner) намеренно НЕ указан в РазработкаЗависитОт:
// reusable workflow autumn-library/workflows ставит его отдельным шагом
// `opm install -l oneunit`. Если перечислить его и здесь, opm разворачивает
// его транзитивные deps плоско в ./oscript_modules/, и второй вызов
// reusable workflow ломает структуру `oneunit/oscript_modules/annotations`,
// после чего CLI oneunit падает с «Библиотека не найдена: annotations».
// Для локальной разработки oneunit ставится отдельно: `opm install oneunit`.

// opm build зовёт эту процедуру до упаковки: собирает скрипт подсветки кода из shiki той
// версии, что закреплена в tools/highlight/package-lock.json.
//
// Параметры:
//   РабочийКаталог - Строка - каталог исходников пакета; может прийти относительным, например «.»
//
Процедура ПередСборкой(Знач РабочийКаталог) Экспорт
    Каталог = ОбъединитьПути(Новый Файл(РабочийКаталог).ПолноеИмя, "tools", "highlight");
    ВыполнитьNpm("ci --no-audit --no-fund", Каталог);
    ВыполнитьNpm("run build", Каталог);
КонецПроцедуры

// npm на Windows — cmd-обёртка, её запускает только командный процессор
Процедура ВыполнитьNpm(Знач Аргументы, Знач Каталог)
    Команда = "npm " + Аргументы;
    СистемнаяИнформация = Новый СистемнаяИнформация;
    Если СтрНайти(НРег(СистемнаяИнформация.ВерсияОС), "windows") > 0 Тогда
        Команда = "cmd /c " + Команда;
    КонецЕсли;

    КодВозврата = 0;
    ЗапуститьПриложение(Команда, Каталог, Истина, КодВозврата);
    Если КодВозврата <> 0 Тогда
        ВызватьИсключение СтрШаблон("Скрипт подсветки кода не собран: «%1» в %2 вернула код %3",
            Команда, Каталог, КодВозврата);
    КонецЕсли;
КонецПроцедуры

Описание.Имя("oscript-md")
		.Версия("0.3.0")
		.ВерсияСреды("2.0.0")
		.Автор("Egor Ivanov")
		.АдресАвтора("Segate@inbox.ru")
		.АдресРепозитория("https://github.com/segate-ekb/oscript-md")
		.Описание("Markdown-парсер и рендерер на чистом OneScript: CommonMark, GFM-расширения и безопасный рендер недоверенного Markdown. Везёт скрипт подсветки кода BSL для браузера на shiki (MIT).")

		.ЗависитОт("html-sanitizer", "0.2.0")
		.РазработкаЗависитОт("html-sanitizer", "0.2.0")
		.РазработкаЗависитОт("asserts",   "1.6.1")
		.РазработкаЗависитОт("1commands", "1.5.0")

		.ВключитьФайл("src")
		.ВключитьФайл("packagedef")
		.ВключитьФайл("README.md")
		.ВключитьФайл("LICENSE");
