////////////////////////////////////////////////////////////
// Описание пакета oscript-md для сборки и установки через opm.
// Полную документацию по формату см. на hub.oscript.io/packaging.
//
// oscript-md — Markdown-парсер и рендерер на чистом OneScript:
// CommonMark + GFM-расширения (tables, tasklists, strikethrough, autolinks).
// Разбор и рендеринг реализованы без сторонних библиотек; единственная
// зависимость рантайма — html-sanitizer, её зовёт Markdown.ВБезопасныйHTML
// (рендер недоверенного Markdown с санитизацией по allowlist). Своего
// санитайзера библиотека не заводит: это отдельная предметная область
// с отдельным XSS-корпусом, и живёт она в html-sanitizer.
//
// РазработкаЗависитОт ниже относится только к процессу разработки
// (утверждения в тестах, обвязка над дочерними процессами в tasks/).
//
// oneunit (test-runner) намеренно НЕ указан в РазработкаЗависитОт:
// reusable workflow autumn-library/workflows ставит его отдельным шагом
// `opm install -l oneunit`. Если перечислить его и здесь, opm разворачивает
// его транзитивные deps плоско в ./oscript_modules/, и второй вызов
// reusable workflow ломает структуру `oneunit/oscript_modules/annotations`,
// после чего CLI oneunit падает с «Библиотека не найдена: annotations».
// Для локальной разработки oneunit ставится отдельно: `opm install oneunit`.

Описание.Имя("oscript-md")
		.Версия("0.3.0")
		.ВерсияСреды("2.0.0")
		.Автор("Egor Ivanov")
		.АдресАвтора("Segate@inbox.ru")
		.АдресРепозитория("https://github.com/segate-ekb/oscript-md")
		.Описание("Markdown-парсер и рендерер на чистом OneScript: CommonMark, GFM-расширения и безопасный рендер недоверенного Markdown. Отдаёт тег подсветки кода BSL и языка запросов на shiki для браузера.")

		.ЗависитОт("html-sanitizer", "0.2.0")
		.РазработкаЗависитОт("html-sanitizer", "0.2.0")
		.РазработкаЗависитОт("asserts",   "1.6.1")
		.РазработкаЗависитОт("1commands", "1.5.0")

		.ВключитьФайл("src")
		.ВключитьФайл("packagedef")
		.ВключитьФайл("README.md")
		.ВключитьФайл("LICENSE");
