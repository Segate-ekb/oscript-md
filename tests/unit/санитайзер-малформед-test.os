#Использовать "../../src"
#Использовать asserts

// Устойчивость к малформед-HTML: незакрытые теги, кривая вложенность,
// комментарии, CDATA, незакрытые кавычки, мусорные символы.
// Выход всегда максимально well-formed.

&Тест
Процедура НезакрытыйТегЗакрывается() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("<p>текст")).Равно("<p>текст</p>");

КонецПроцедуры

&Тест
Процедура НезакрытаяВложенностьЗакрывается() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("<ul><li>раз<li>два"))
        .Равно("<ul><li>раз<li>два</li></li></ul>");

КонецПроцедуры

&Тест
Процедура ПерепутанныйПорядокЗакрытия() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("<strong><em>x</strong></em>"))
        .Равно("<strong><em>x</em></strong>");

КонецПроцедуры

&Тест
Процедура ЛишнееЗакрытиеИгнорируется() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("</p>одинокий</em>")).Равно("одинокий");

КонецПроцедуры

&Тест
Процедура КомментарийУдаляется() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("<p>до<!-- секрет -->после</p>"))
        .Равно("<p>допосле</p>");

КонецПроцедуры

&Тест
Процедура НезакрытыйКомментарийУдаляетсяДоКонца() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("<p>до</p><!-- незакрытый <script>alert(1)</script>"))
        .Равно("<p>до</p>");

КонецПроцедуры

&Тест
Процедура УсловныйКомментарийУдаляется() Экспорт

    Результат = Markdown.ОчиститьHTML("<!--[if IE]><script>alert(1)</script><![endif]--><p>ок</p>");
    Ожидаем.Что(Результат).Равно("<p>ок</p>");

КонецПроцедуры

&Тест
Процедура CDATAУдаляется() Экспорт

    Результат = Markdown.ОчиститьHTML("до<![CDATA[<script>alert(1)</script>]]>после");
    Ожидаем.Что(Результат).Равно("допосле");

КонецПроцедуры

&Тест
Процедура ДоктайпИИнструкцииУдаляются() Экспорт

    Результат = Markdown.ОчиститьHTML("<!DOCTYPE html><?php evil(); ?><p>ок</p>");
    Ожидаем.Что(Результат).Равно("<p>ок</p>");

КонецПроцедуры

&Тест
Процедура УголкиВТекстеЭкранируются() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("<p>a < b и x <3 да</p>"))
        .Равно("<p>a &lt; b и x &lt;3 да</p>");

КонецПроцедуры

&Тест
Процедура НеразрешенныйТегУдаляетсяССохранениемТекста() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("<div><span>текст</span></div>")).Равно("текст");

КонецПроцедуры

&Тест
Процедура НезакрытаяКавычкаАтрибутаНеЛомаетВыход() Экспорт

    // значение с незакрытой кавычкой поглощает остаток строки — тег остаётся пустым
    Результат = Markdown.ОчиститьHTML("<p foo=""bar>текст</p>");
    Ожидаем.Что(Результат).Равно("<p></p>");

КонецПроцедуры

&Тест
Процедура НезакрытаяКавычкаРазрешенногоАтрибутаЭкранируется() Экспорт

    // весь хвост становится значением href; onclick оказывается внутри значения и инертен
    Результат = Markdown.ОчиститьHTML("<a href=""https://e.com/x onclick=alert(1)>клик");
    Ожидаем.Что(Результат).Содержит("<a href=""https://e.com/x onclick=alert(1)&gt;клик""");
    Ожидаем.Что(Результат).Не_().Содержит("onclick=""");

КонецПроцедуры

&Тест
Процедура ТегВнутриЗначенияАтрибутаНеИсполняется() Экспорт

    Настройки = Markdown.НастройкиСанитизацииПоУмолчанию().РазрешитьТег("p", "title");
    Результат = Markdown.ОчиститьHTML("<p title=""<script>alert(1)</script>"">x</p>", Настройки);
    Ожидаем.Что(Результат).Равно("<p title=""&lt;script&gt;alert(1)&lt;/script&gt;"">x</p>");

КонецПроцедуры

&Тест
Процедура ЗакрывающийТегСАтрибутамиОбрабатывается() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("<p>x</p onclick=alert(1)>")).Равно("<p>x</p>");

КонецПроцедуры

&Тест
Процедура ПустойИБуквенныйМусорПослеУголка() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("</><p>ок</p></ >")).Равно("<p>ок</p>");

КонецПроцедуры

&Тест
Процедура СамозакрытыйНепустойТегНормализуется() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("<p/>после")).Равно("<p></p>после");

КонецПроцедуры

&Тест
Процедура ГлубокаяВложенностьНеПадает() Экспорт

    HTML = "";
    Для Индекс = 1 По 60 Цикл
        HTML = HTML + "<blockquote>";
    КонецЦикла;
    HTML = HTML + "дно";

    Результат = Markdown.ОчиститьHTML(HTML);
    Ожидаем.Что(Результат).Содержит("дно");
    Ожидаем.Что(СтрЧислоВхождений(Результат, "</blockquote>")).Равно(60);

КонецПроцедуры

&Тест
Процедура ОченьГлубокаяВложенностьНеВисит() Экспорт

    // защита от DoS: закрытие тега ищет ближайший одноимённый сверху стека,
    // поэтому корректно вложенный документ обрабатывается близко к линейному
    // времени, а не за O(n^2)
    Уровней = 20000;
    Открытие = "";
    Закрытие = "";
    Для Индекс = 1 По Уровней Цикл
        Открытие = Открытие + "<blockquote>";
        Закрытие = Закрытие + "</blockquote>";
    КонецЦикла;
    HTML = Открытие + "дно" + Закрытие;

    Старт = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Результат = Markdown.ОчиститьHTML(HTML);
    Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Старт;

    Ожидаем.Что(СтрЧислоВхождений(Результат, "</blockquote>")).Равно(Уровней);
    Ожидаем.Что(Результат).Содержит("дно");
    // порог заведомо велик (O(n^2)-версия занимала здесь десятки секунд)
    Ожидаем.Что(Прошло < 10000, "обработка заняла " + Прошло + " мс").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура УголокПередБуквойСтановитсяНеизвестнымТегом() Экспорт

    // "<abc" распознаётся как начало тега (как в браузере) и удаляется как неразрешённый
    Ожидаем.Что(Markdown.ОчиститьHTML("<p>смотри <abc внимательно</p>"))
        .Равно("<p>смотри </p>");

КонецПроцедуры
