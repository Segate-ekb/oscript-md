#Использовать "../../src"
#Использовать asserts

// Юникод: RTLO и невидимые символы, гомоглифы, эмодзи.
//
// Что ловится:
//   - невидимые/направляющие символы (RTLO, LRO, ZWSP, BOM и пр.) внутри URL
//     удаляются до проверки схемы и не попадают в вывод;
//   - обфускация схемы zero-width символами нейтрализуется.
// Что НЕ ловится (задокументированные ограничения):
//   - гомоглифы в доменах (кириллическая "а" в "аpple.com") — это валидный URL,
//     защита от фишинга доменов вне зоны ответственности санитайзера;
//   - RTLO в обычном тексте сохраняется: это вопрос отображения, а не XSS.

&Тест
Процедура КириллицаСохраняется() Экспорт

    HTML = "<p>Привет, мир! Ёлка, съешь ещё этих мягких булок.</p>";
    Ожидаем.Что(Markdown.ОчиститьHTML(HTML)).Равно(HTML);

КонецПроцедуры

&Тест
Процедура ЭмодзиСохраняются() Экспорт

    HTML = "<p>Сборка прошла " + Символ(9989) + "</p>";
    Ожидаем.Что(Markdown.ОчиститьHTML(HTML)).Равно(HTML);

КонецПроцедуры

&Тест
Процедура RTLOвТекстеСохраняется() Экспорт

    // направление текста — забота отображения, не санитайзера
    RTLO = Символ(8238);
    Результат = Markdown.ОчиститьHTML("<p>файл " + RTLO + "txt.exe</p>");
    Ожидаем.Что(СтрНайти(Результат, RTLO) > 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура RTLOвURLУдаляется() Экспорт

    RTLO = Символ(8238);
    Результат = Markdown.ОчиститьHTML("<a href=""https://e.com/" + RTLO + "exe.txt"">x</a>");
    Ожидаем.Что(СтрНайти(Результат, RTLO)).Равно(0);
    Ожидаем.Что(Результат).Содержит("href=""https://e.com/exe.txt""");

КонецПроцедуры

&Тест
Процедура ZeroWidthВСхемеНейтрализуется() Экспорт

    ZWSP = Символ(8203);
    Результат = Markdown.ОчиститьHTML("<a href=""jav" + ZWSP + "ascript:alert(1)"">x</a>");
    Ожидаем.Что(Результат).Равно("<a>x</a>");

КонецПроцедуры

&Тест
Процедура BOMвСхемеНейтрализуется() Экспорт

    BOM = Символ(65279);
    Результат = Markdown.ОчиститьHTML("<a href=""" + BOM + "javascript:alert(1)"">x</a>");
    Ожидаем.Что(Результат).Равно("<a>x</a>");

КонецПроцедуры

&Тест
Процедура ГомоглифыВДоменеНеЛовятся() Экспорт

    // задокументированное ограничение: URL с кириллическим доменом валиден и проходит
    URL = "https://" + "е" + "xample.com"; // "е" — кириллическая
    Результат = Markdown.ОчиститьHTML("<a href=""" + URL + """>x</a>");
    Ожидаем.Что(Результат).Содержит("href=""" + URL + """");

КонецПроцедуры

&Тест
Процедура ЮникодВЗначенияхАтрибутовСохраняется() Экспорт

    HTML = "<img src=""/картинки/ёж.png"" alt=""Ёж и юла""/>";
    Ожидаем.Что(Markdown.ОчиститьHTML("<img src=""/картинки/ёж.png"" alt=""Ёж и юла"">")).Равно(HTML);

КонецПроцедуры
