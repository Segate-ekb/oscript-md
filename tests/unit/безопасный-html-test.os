#Использовать "../../src"
#Использовать asserts

// Markdown.ВБезопасныйHTML / Markdown.ОчиститьHTML — фасад над html-sanitizer.
// Сам корпус XSS-векторов живёт в html-sanitizer вместе с реализацией; здесь
// проверяется шов: что санитизация вообще включена в путь, что параметр настроек
// доходит до санитайзера и что обычная разметка от этого не страдает.

#Область РежетОпасное

&Тест
Процедура ВБезопасныйHTML_РежетJavascriptСсылкуИзMarkdown() Экспорт
    // ссылку собирает сам рендерер: сырого HTML здесь нет вовсе, и безопасный
    // режим парсера тут не помогает — режет только санитизация
    Исходник = "[зло](javascript:alert('L'))" + Символы.ПС + Символы.ПС
        + "![картинка](javascript:alert('I'))";

    Сырой = НРег(Markdown.ВHTML(Исходник));
    Безопасный = НРег(Markdown.ВБезопасныйHTML(Исходник));

    Утверждения.ПроверитьИстину(СтрНайти(Сырой, "javascript:") > 0,
        "рендерер сам по себе схему URL не фильтрует — иначе тест ничего не стережёт");
    Утверждения.ПроверитьЛожь(СтрНайти(Безопасный, "javascript:") > 0,
        "javascript-URL не должен доходить до выдачи");
    Утверждения.ПроверитьИстину(СтрНайти(Безопасный, "зло") > 0, "текст ссылки сохранён");
КонецПроцедуры

&Тест
Процедура ВБезопасныйHTML_РежетScriptИзСырогоHTML() Экспорт
    // пресет commonmark пропускает сырой HTML — санитизация здесь единственная защита
    Исходник = "# Пакет" + Символы.ПС + Символы.ПС + "<script>alert('S')</script>";

    Сырой = НРег(Markdown.ВHTML(Исходник, Markdown.НастройкиCommonMark()));
    Безопасный = НРег(Markdown.ВБезопасныйHTML(Исходник, Markdown.НастройкиCommonMark()));

    Утверждения.ПроверитьИстину(СтрНайти(Сырой, "<script") > 0,
        "пресет действительно пропускает сырой HTML");
    Утверждения.ПроверитьЛожь(СтрНайти(Безопасный, "<script") > 0, "тег script вырезан");
    Утверждения.ПроверитьЛожь(СтрНайти(Безопасный, "alert('s')") > 0,
        "тело скрипта удалено вместе с тегом");
    Утверждения.ПроверитьИстину(СтрНайти(Безопасный, "<h1>пакет</h1>") > 0,
        "заголовок остался на месте");
КонецПроцедуры

&Тест
Процедура ВБезопасныйHTML_РежетОбработчикиСобытий() Экспорт
    Исходник = "<img src=x onerror=""alert('E')"">" + Символы.ПС + Символы.ПС
        + "<div onclick=""evil()"">клик</div>";

    Результат = НРег(Markdown.ВБезопасныйHTML(Исходник, Markdown.НастройкиCommonMark()));

    Утверждения.ПроверитьЛожь(СтрНайти(Результат, "onerror") > 0, "onerror вырезан");
    Утверждения.ПроверитьЛожь(СтрНайти(Результат, "onclick") > 0, "onclick вырезан");
    Утверждения.ПроверитьИстину(СтрНайти(Результат, "клик") > 0, "текст сохранён");
КонецПроцедуры

#КонецОбласти

#Область НеПортитНормальное

&Тест
Процедура ВБезопасныйHTML_СохраняетОбычнуюРазметку() Экспорт
    Исходник = "# Заголовок" + Символы.ПС + Символы.ПС
        + "Абзац с **жирным** и [ссылкой](https://example.com/x)." + Символы.ПС + Символы.ПС
        + "- пункт" + Символы.ПС + "- ещё";

    Результат = Markdown.ВБезопасныйHTML(Исходник);

    Утверждения.ПроверитьВхождение(Результат, "<h1>Заголовок</h1>");
    Утверждения.ПроверитьВхождение(Результат, "<strong>жирным</strong>");
    Утверждения.ПроверитьВхождение(Результат, "href=""https://example.com/x""");
    Утверждения.ПроверитьВхождение(Результат, "<li>пункт</li>");
КонецПроцедуры

&Тест
Процедура ВБезопасныйHTML_СохраняетБлокКодаСЯзыком() Экспорт
    Исходник = "```bsl" + Символы.ПС + "Сообщить(1);" + Символы.ПС + "```";

    Результат = Markdown.ВБезопасныйHTML(Исходник);

    Утверждения.ПроверитьВхождение(Результат, "<pre>");
    Утверждения.ПроверитьВхождение(Результат, "class=""language-bsl""");
    Утверждения.ПроверитьВхождение(Результат, "Сообщить(1);");
КонецПроцедуры

&Тест
Процедура ВБезопасныйHTML_СохраняетТаблицуGFM() Экспорт
    Исходник = "| А | Б |" + Символы.ПС + "| --- | ---: |" + Символы.ПС + "| 1 | 2 |";

    Результат = Markdown.ВБезопасныйHTML(Исходник, Markdown.НастройкиGitHubLike());

    Утверждения.ПроверитьВхождение(Результат, "<table>");
    Утверждения.ПроверитьВхождение(Результат, "<th>А</th>");
    Утверждения.ПроверитьВхождение(Результат, "align=""right""");
КонецПроцедуры

&Тест
Процедура ВБезопасныйHTML_СохраняетЗачёркиваниеGFM() Экспорт
    Результат = Markdown.ВБезопасныйHTML("~~снято~~", Markdown.НастройкиGitHubLike());

    Утверждения.ПроверитьВхождение(Результат, "<del>снято</del>");
КонецПроцедуры

&Тест
Процедура ВБезопасныйHTML_СохраняетЧекбоксыСпискаЗадач() Экспорт
    Исходник = "- [x] сделано" + Символы.ПС + "- [ ] осталось";

    Результат = Markdown.ВБезопасныйHTML(Исходник, Markdown.НастройкиGitHubLike());

    Утверждения.ПроверитьВхождение(Результат, "type=""checkbox""");
    Утверждения.ПроверитьВхождение(Результат, "checked=""""");
    Утверждения.ПроверитьВхождение(Результат, "disabled=""""");
    Утверждения.ПроверитьЛожь(СтрНайти(Результат, "[x]") > 0,
        "исходная скобочная запись задачи до выдачи не доходит");
КонецПроцедуры

&Тест
Процедура ВБезопасныйHTML_ПрофильРазрешаетНеБольшеЧемПечатаетРендерер() Экспорт
    // input разрешён ради чекбокса, но только тремя атрибутами: любой другой —
    // в том числе обработчик события — обязан быть снят
    Результат = Markdown.ОчиститьHTML(
        "<input type=""text"" name=""password"" onfocus=""evil()"" value=""я"">"
        + "<del onmouseover=""evil()"">з</del>");

    Утверждения.ПроверитьЛожь(СтрНайти(Результат, "onfocus") > 0, "обработчик на input снят");
    Утверждения.ПроверитьЛожь(СтрНайти(Результат, "onmouseover") > 0, "обработчик на del снят");
    Утверждения.ПроверитьЛожь(СтрНайти(Результат, "name=") > 0, "чужой атрибут input снят");
    Утверждения.ПроверитьЛожь(СтрНайти(Результат, "value=") > 0, "значение поля не переносится");
КонецПроцедуры

&Тест
Процедура ВБезопасныйHTML_ПустойВходДаётПустуюСтроку() Экспорт
    Утверждения.ПроверитьРавенство("", Markdown.ВБезопасныйHTML(""));
КонецПроцедуры

#КонецОбласти

#Область НастройкиДоходятДоСанитайзера

&Тест
Процедура ВБезопасныйHTML_ПринимаетСвойAllowlist() Экспорт
    Пустые = СанитизацияHTML.ПустыеНастройки().РазрешитьТег("p");

    Результат = Markdown.ВБезопасныйHTML("# Заголовок" + Символы.ПС + Символы.ПС + "абзац",
        Неопределено, Пустые);

    Утверждения.ПроверитьЛожь(СтрНайти(Результат, "<h1>") > 0,
        "заголовок не в allowlist — тег снят");
    Утверждения.ПроверитьВхождение(Результат, "Заголовок");
    Утверждения.ПроверитьВхождение(Результат, "<p>абзац</p>");
КонецПроцедуры

&Тест
Процедура ОчиститьHTML_ЧиститГотовыйHTML() Экспорт
    Результат = Markdown.ОчиститьHTML("<p>текст<script>alert(1)</script></p>");

    Утверждения.ПроверитьРавенство("<p>текст</p>", Результат);
КонецПроцедуры

&Тест
Процедура ОчиститьHTML_ПринимаетСвойAllowlist() Экспорт
    Свой = СанитизацияHTML.НастройкиMarkdown().ЗапретитьТег("strong");

    Утверждения.ПроверитьРавенство("<p>ж</p>", Markdown.ОчиститьHTML("<p><strong>ж</strong></p>", Свой));
КонецПроцедуры

&Тест
Процедура НастройкиСанитизацииПоУмолчанию_НовыйОбъектНаКаждыйВызов() Экспорт
    // общий объект настроек отравил бы соседние вызовы: правка одного профиля
    // молча меняла бы санитизацию во всём процессе
    Свой = Markdown.НастройкиСанитизацииПоУмолчанию().ЗапретитьТег("strong");

    Утверждения.ПроверитьРавенство("<p>ж</p>", Markdown.ОчиститьHTML("<p><strong>ж</strong></p>", Свой));
    Утверждения.ПроверитьРавенство("<p><strong>ж</strong></p>",
        Markdown.ОчиститьHTML("<p><strong>ж</strong></p>"));
КонецПроцедуры

#КонецОбласти
