#Использовать asserts
#Использовать "../../src"

// Тег подсветки кода для страницы и контракт рендера, по которому тег находит код.

&Тест
Процедура ТегСкрипта_МодульГрузитShikiТочнойВерсииСESMSHИРаскрашиваетБлокиBSLИЗапросов() Экспорт
    Тег = MarkdownПодсветка.ТегСкрипта();

    Импорт = Новый РегулярноеВыражение("from 'https://esm\.sh/shiki@\d+\.\d+\.\d+'");
    Блоки = "'pre > code.language-bsl, pre > code.language-1c, pre > code.language-sdbl, pre > code.language-1c-query'";
    Утверждения.ПроверитьИстину(СтрНачинаетсяС(Тег, "<script type=""module"">"), Тег);
    Утверждения.ПроверитьИстину(Импорт.Совпадает(Тег), Тег);
    Утверждения.ПроверитьИстину(СтрНайти(Тег, Блоки) > 0, Тег);
    Утверждения.ПроверитьИстину(СтрЗаканчиваетсяНа(Тег, "</script>"), Тег);
КонецПроцедуры

&Тест
Процедура БезопасныйHTML_БлокиBSLИЗапросовДаютCodeСКлассомЯзыкаВнутриPre() Экспорт
    HTML = Markdown.ВБезопасныйHTML("```bsl
    |Возврат Истина;
    |```
    |
    |```1c
    |Возврат Ложь;
    |```
    |
    |```sdbl
    |ВЫБРАТЬ 1
    |```
    |
    |```1c-query
    |ВЫБРАТЬ 2
    |```");

    Утверждения.ПроверитьИстину(СтрНайти(HTML, "<pre><code class=""language-bsl"">") > 0, HTML);
    Утверждения.ПроверитьИстину(СтрНайти(HTML, "<pre><code class=""language-1c"">") > 0, HTML);
    Утверждения.ПроверитьИстину(СтрНайти(HTML, "<pre><code class=""language-sdbl"">") > 0, HTML);
    Утверждения.ПроверитьИстину(СтрНайти(HTML, "<pre><code class=""language-1c-query"">") > 0, HTML);
КонецПроцедуры
