#Использовать asserts
#Использовать "../../src"

// Скрипт подсветки кода в пакете и контракт рендера, по которому скрипт находит код.

&Тест
Процедура ФайлСкриптаЛежитВКаталогеHighlightПакета() Экспорт
    КаталогSrc = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "src");
    Ожидаемый = ОбъединитьПути(КаталогSrc, "highlight", "oscript-md-highlight.js");

    Утверждения.ПроверитьРавенство(Новый Файл(Ожидаемый).ПолноеИмя, MarkdownПодсветка.ФайлСкрипта());
КонецПроцедуры

&Тест
Процедура БезопасныйHTML_БлокиBSLИ1CДаютCodeСКлассомЯзыкаВнутриPre() Экспорт
    HTML = Markdown.ВБезопасныйHTML("```bsl
    |Возврат Истина;
    |```
    |
    |```1c
    |Возврат Ложь;
    |```");

    Утверждения.ПроверитьИстину(СтрНайти(HTML, "<pre><code class=""language-bsl"">") > 0, HTML);
    Утверждения.ПроверитьИстину(СтрНайти(HTML, "<pre><code class=""language-1c"">") > 0, HTML);
КонецПроцедуры
