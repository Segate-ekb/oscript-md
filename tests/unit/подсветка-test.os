#Использовать "../../src"
#Использовать asserts
#Использовать 1commands

// MarkdownПодсветка — подсветка кода BSL в браузере: пути к файлам пакета и имя атрибута,
// по которому скрипт подсветки находит код на странице. Движок в git не хранится, его
// собирают opm build и tasks/test*.os. Тесты, которым нужны собранный движок или node,
// в CI идут всегда, а локально без них пропускаются с подсказкой, как собрать движок.
// Скрипт проверяется тем, что исполняется: node запускает его с движком пакета над
// страницей из двух блоков BSL. Там же — контракт рендера, на котором держится скрипт:
// блок bsl и 1c печатается элементом code с классом language-* прямо внутри pre.

#Область ФайлыПоставки

&Тест
Процедура ФайлыПодсветкиЛежатВКаталогеПоставкиВнутриSrc() Экспорт
    Каталог = MarkdownПодсветка.Каталог();

    Утверждения.ПроверитьИстину(Новый Файл(Каталог).ЭтоКаталог(), "каталог поставки: " + Каталог);
    Утверждения.ПроверитьИстину(СтрНачинаетсяС(Каталог, КаталогSrc() + ПолучитьРазделительПути()),
        СтрШаблон("каталог поставки %1 лежит вне %2", Каталог, КаталогSrc()));
    Утверждения.ПроверитьРавенство(Новый Файл(Каталог).ПолноеИмя, Каталог, "путь полный и без «..»");

    Файлы = ФайлыПоставки();
    Различные = Новый Соответствие;
    Для Каждого Путь Из Файлы Цикл
        Утверждения.ПроверитьРавенство(ОбъединитьПути(Каталог, Новый Файл(Путь).Имя), Путь,
            "файл вне каталога поставки");
        Различные.Вставить(Путь, Истина);
    КонецЦикла;
    Утверждения.ПроверитьРавенство(Файлы.Количество(), Различные.Количество(), "у каждой функции свой файл");

    ПроверитьЧтоФайлЕсть(MarkdownПодсветка.ФайлСкрипта());
    ПроверитьЧтоФайлЕсть(MarkdownПодсветка.ФайлСтилей());
КонецПроцедуры

&Тест
&ВключенЕсли(Значение = "() -> ДвижокСобранИлиЭтоCI()", Причина = "соберите движок: oscript tasks/test.os или opm build . (нужен node 20+)")
Процедура ДвижокИФайлЛицензийСобраныПоПутямМодуля() Экспорт
    ПроверитьЧтоФайлЕсть(MarkdownПодсветка.ФайлДвижка());
    ПроверитьЧтоФайлЕсть(MarkdownПодсветка.ФайлЛицензий());
КонецПроцедуры

&Тест
Процедура КаталогИщетсяОтФайлаМодуляГдеБыПакетНиСтоял() Экспорт
    // пакет, установленный в чужой проект: src/Модули рядом с src/highlight, а текущий
    // каталог процесса к этому пакету отношения не имеет
    Проект = ПолучитьИмяВременногоФайла();
    SrcПакета = ОбъединитьПути(ОбъединитьПути(Проект, "oscript_modules", "oscript-md"), "src");
    КопияМодуля = ОбъединитьПути(SrcПакета, "Модули", "MarkdownПодсветка.os");
    СоздатьКаталог(ОбъединитьПути(SrcПакета, "Модули"));
    КопироватьФайл(ОбъединитьПути(КаталогSrc(), "Модули", "MarkdownПодсветка.os"), КопияМодуля);

    Попытка
        Установленный = ЗагрузитьСценарий(КопияМодуля);
        Утверждения.ПроверитьРавенство(ОбъединитьПути(SrcПакета, "highlight"), Установленный.Каталог());
        Утверждения.ПроверитьРавенство(ОбъединитьПути(SrcПакета, "highlight", "oscript-md-highlight.js"),
            Установленный.ФайлСкрипта());
    Исключение
        УдалитьФайлы(Проект);
        ВызватьИсключение;
    КонецПопытки;
    УдалитьФайлы(Проект);
КонецПроцедуры

#КонецОбласти

#Область СкриптНаходитКодПоАтрибутуМодуля

&Тест
&ВключенЕсли(Значение = "() -> ДвижокИNodeЕстьИлиЭтоCI()", Причина = "соберите движок: oscript tasks/test.os или opm build . (нужен node 20+)")
Процедура СкриптРаскрашиваетКодТолькоВЭлементеСАтрибутомИзМодуля() Экспорт
    Раскрашенные = БлокиРаскрашенныеСкриптом(MarkdownПодсветка.ИмяАтрибута());

    Утверждения.ПроверитьРавенство("с-атрибутом", Раскрашенные,
        "скрипт пакета с движком пакета раскрашивает блок в элементе с атрибутом модуля, и только его");
КонецПроцедуры

#КонецОбласти

#Область КонтрактРендера

&Тест
Процедура ВHTML_БлокиBSLИ1CДаютCodeСЯзыкомПрямоВнутриPre() Экспорт
    Для Каждого Язык Из ЯзыкиПодсветки() Цикл
        Исходник = БлокКода(Язык);

        ПроверитьКодСЯзыкомВнутриPre(Markdown.ВHTML(Исходник), Язык);
        ПроверитьКодСЯзыкомВнутриPre(Markdown.ВHTML(Исходник, Markdown.НастройкиGitHubLike()), Язык);
    КонецЦикла;
КонецПроцедуры

&Тест
Процедура ВБезопасныйHTML_БлокиBSLИ1CДаютCodeСЯзыкомПрямоВнутриPre() Экспорт
    Для Каждого Язык Из ЯзыкиПодсветки() Цикл
        Исходник = БлокКода(Язык);

        ПроверитьКодСЯзыкомВнутриPre(Markdown.ВБезопасныйHTML(Исходник), Язык);
        ПроверитьКодСЯзыкомВнутриPre(Markdown.ВБезопасныйHTML(Исходник, Markdown.НастройкиGitHubLike()), Язык);
    КонецЦикла;
КонецПроцедуры

&Тест
Процедура ВБезопасныйHTML_ВырезаетАтрибутПодсветкиИзЧужогоHTML() Экспорт
    // значение атрибута — адрес модуля, который исполнит скрипт: чужой Markdown задать его не вправе
    Атрибут = MarkdownПодсветка.ИмяАтрибута();
    Исходник = СтрШаблон("<div %1=""https://evil.example/x.mjs"">", Атрибут) + Символы.ПС + Символы.ПС
        + БлокКода("bsl") + Символы.ПС + Символы.ПС + "</div>";

    Сырой = Markdown.ВHTML(Исходник, Markdown.НастройкиCommonMark());
    Безопасный = Markdown.ВБезопасныйHTML(Исходник, Markdown.НастройкиCommonMark());

    Утверждения.ПроверитьРавенство(1, ЭлементыСАтрибутом(Сырой, Атрибут).Количество(),
        "пресет пропускает сырой HTML — иначе тест ничего не стережёт: " + Сырой);
    Утверждения.ПроверитьРавенство(0, ЭлементыСАтрибутом(Безопасный, Атрибут).Количество(),
        "атрибут подсветки из чужого HTML вырезан: " + Безопасный);
КонецПроцедуры

&Тест
Процедура РазборВидитТолькоCodeПрямоВнутриPre() Экспорт
    HTML = "<p><code class=""language-bsl"">А</code></p>"
        + "<pre><span><code class=""language-1c"">Б</code></span></pre>"
        + "<pre><code class=""x language-bsl"">В</code></pre>"
        + "<pre>Г<code class=""language-1c"">Д</code></pre>";

    Утверждения.ПроверитьРавенство("x language-bsl|language-1c", СтрСоединить(КлассыКодаВнутриPre(HTML), "|"));
КонецПроцедуры

#КонецОбласти

#Область УсловияТестов

// В CI (задана переменная CI) эти тесты не пропускаются никогда: пропавшие там движок
// или node обязаны краснеть, а не молчать
Функция ДвижокСобранИлиЭтоCI() Экспорт
    Возврат ЭтоCI() ИЛИ ДвижокСобран();
КонецФункции

Функция ДвижокИNodeЕстьИлиЭтоCI() Экспорт
    Возврат ЭтоCI() ИЛИ (ДвижокСобран() И СборкаДвижка().ВерсияNode() >= 20);
КонецФункции

Функция ЭтоCI()
    Возврат ЗначениеЗаполнено(ПолучитьПеременнуюСреды("CI"));
КонецФункции

Функция ДвижокСобран()
    Возврат Новый Файл(MarkdownПодсветка.ФайлДвижка()).Существует();
КонецФункции

#КонецОбласти

#Область Служебные

Функция КаталогSrc()
    Возврат ОбъединитьПути(КаталогРепозитория(), "src");
КонецФункции

Функция КаталогРепозитория()
    Возврат Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..")).ПолноеИмя;
КонецФункции

// Та же сборка движка, что зовут opm build и tasks/test*.os; отсюда нужна её проверка node
Функция СборкаДвижка()
    Возврат ЗагрузитьСценарий(ОбъединитьПути(КаталогРепозитория(), "tools", "highlight", "собрать.os"));
КонецФункции

Функция ФайлыПоставки()
    Файлы = Новый Массив;
    Файлы.Добавить(MarkdownПодсветка.ФайлСкрипта());
    Файлы.Добавить(MarkdownПодсветка.ФайлДвижка());
    Файлы.Добавить(MarkdownПодсветка.ФайлСтилей());
    Файлы.Добавить(MarkdownПодсветка.ФайлЛицензий());
    Возврат Файлы;
КонецФункции

Процедура ПроверитьЧтоФайлЕсть(Путь)
    Файл = Новый Файл(Путь);
    Утверждения.ПроверитьИстину(Файл.Существует() И Файл.ЭтоФайл(), "нет файла " + Путь);
КонецПроцедуры

// Метки блоков, которые раскрасил скрипт пакета с движком пакета на странице, где один
// блок BSL стоит в элементе с атрибутом, а другой — вне его; по одной на строку
Функция БлокиРаскрашенныеСкриптом(Атрибут)
    Команда = Новый Команда;
    Команда.УстановитьИсполнениеЧерезКомандыСистемы(Ложь);
    Команда.УстановитьКоманду("node");
    Команда.ДобавитьПараметр("--no-warnings");
    Команда.ДобавитьПараметр(Команда.ОбернутьВКавычки(
        ОбъединитьПути(ТекущийСценарий().Каталог, "страница-с-подсветкой.mjs")));
    Команда.ДобавитьПараметр(Команда.ОбернутьВКавычки(MarkdownПодсветка.ФайлСкрипта()));
    Команда.ДобавитьПараметр(Команда.ОбернутьВКавычки(MarkdownПодсветка.ФайлДвижка()));
    Команда.ДобавитьПараметр(Команда.ОбернутьВКавычки(Атрибут));
    Команда.УстановитьКодировкуВывода(КодировкаТекста.UTF8);

    Попытка
        КодВозврата = Команда.Исполнить();
    Исключение
        ВызватьИсключение "нужен node 20+ в PATH: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
    КонецПопытки;
    Вывод = СокрЛП(Команда.ПолучитьВывод());

    Утверждения.ПроверитьРавенство(0, КодВозврата, "страница с подсветкой в node: " + Вывод);
    Возврат Вывод;
КонецФункции

Функция ЯзыкиПодсветки()
    Возврат СтрРазделить("bsl,1c", ",");
КонецФункции

Функция БлокКода(Язык)
    Возврат "```" + Язык + Символы.ПС + "Сообщить(""Привет"");" + Символы.ПС + "```";
КонецФункции

Процедура ПроверитьКодСЯзыкомВнутриPre(HTML, Язык)
    Классы = КлассыКодаВнутриPre(HTML);

    Утверждения.ПроверитьРавенство(1, Классы.Количество(), "один code прямо внутри pre: " + HTML);
    Утверждения.ПроверитьИстину(СтрРазделить(Классы[0], " ", Ложь).Найти("language-" + Язык) <> Неопределено,
        СтрШаблон("у code класс language-%1: %2", Язык, HTML));
КонецПроцедуры

// Классы каждого элемента code, который стоит прямо внутри pre: так его ищет скрипт подсветки
Функция КлассыКодаВнутриPre(HTML)
    Чтение = Новый ЧтениеXML;
    Чтение.УстановитьСтроку("<html>" + HTML + "</html>");

    Классы = Новый Массив;
    Предки = Новый Массив;
    Пока Чтение.Прочитать() Цикл
        Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
            Если Чтение.Имя = "code" И Предки[Предки.ВГраница()] = "pre" Тогда
                Классы.Добавить(Строка(Чтение.ЗначениеАтрибута("class")));
            КонецЕсли;
            Предки.Добавить(Чтение.Имя);
        ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
            Предки.Удалить(Предки.ВГраница());
        КонецЕсли;
    КонецЦикла;
    Чтение.Закрыть();

    Возврат Классы;
КонецФункции

// Имена элементов, у которых есть атрибут: так скрипт подсветки находит, где раскрашивать
Функция ЭлементыСАтрибутом(HTML, Атрибут)
    Чтение = Новый ЧтениеXML;
    Чтение.УстановитьСтроку("<html>" + HTML + "</html>");

    Элементы = Новый Массив;
    Пока Чтение.Прочитать() Цикл
        Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.ЗначениеАтрибута(Атрибут) <> Неопределено Тогда
            Элементы.Добавить(Чтение.Имя);
        КонецЕсли;
    КонецЦикла;
    Чтение.Закрыть();

    Возврат Элементы;
КонецФункции

#КонецОбласти
