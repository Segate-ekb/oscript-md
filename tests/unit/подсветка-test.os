#Использовать asserts
#Использовать "../../src"

// Тег подсветки кода для страницы и контракт рендера, по которому тег находит код.

&Тест
Процедура ТегСкрипта_МодульГрузитShikiТочнойВерсииСESMSH() Экспорт
    Тег = MarkdownПодсветка.ТегСкрипта();

    Импорт = Новый РегулярноеВыражение("from 'https://esm\.sh/shiki@\d+\.\d+\.\d+'");
    Утверждения.ПроверитьИстину(СтрНачинаетсяС(Тег, "<script type=""module"">"), Тег);
    Утверждения.ПроверитьИстину(Импорт.Совпадает(Тег), Тег);
    Утверждения.ПроверитьИстину(СтрЗаканчиваетсяНа(Тег, "</script>"), Тег);
КонецПроцедуры

&Тест
Процедура ТегСкрипта_БезТемыДаётЦветаОбеихТемИВыборБраузеруПоColorScheme() Экспорт
    Тег = MarkdownПодсветка.ТегСкрипта();

    Утверждения.ПроверитьИстину(СтрНайти(Тег, "themes: { light: 'github-light', dark: 'github-dark' }") > 0, Тег);
    Утверждения.ПроверитьИстину(СтрНайти(Тег, "defaultColor: 'light-dark()'") > 0, Тег);
КонецПроцедуры

&Тест
Процедура ТегСкрипта_ТемаНеопределеноЗначитТемаНеЗадана() Экспорт
    Утверждения.ПроверитьРавенство(MarkdownПодсветка.ТегСкрипта(Неопределено), MarkdownПодсветка.ТегСкрипта());
КонецПроцедуры

&Тест
Процедура ТегСкрипта_ТемаLightКраситВЦветаСветлойТемыGitHub() Экспорт
    Тег = MarkdownПодсветка.ТегСкрипта("light");

    Утверждения.ПроверитьИстину(СтрНайти(Тег, "defaultColor: 'light'") > 0, Тег);
КонецПроцедуры

&Тест
Процедура ТегСкрипта_ТемаDarkКраситВЦветаТёмнойТемыGitHub() Экспорт
    Тег = MarkdownПодсветка.ТегСкрипта("dark");

    Утверждения.ПроверитьИстину(СтрНайти(Тег, "defaultColor: 'dark'") > 0, Тег);
КонецПроцедуры

&Тест
Процедура ТегСкрипта_ТемаКромеLightИDarkОтвергается() Экспорт
    Для Каждого Тема Из СтрРазделить("тёмная|light dark|dark'}); alert(1); ({'", "|") Цикл
        Ошибка = "";
        Попытка
            MarkdownПодсветка.ТегСкрипта(Тема);
        Исключение
            Ошибка = ИнформацияОбОшибке().Описание;
        КонецПопытки;

        Утверждения.ПроверитьИстину(СтрНайти(Ошибка, Тема) > 0,
            "Тема должна отвергаться ошибкой, которая её называет: " + Тема + " -> " + Ошибка);
    КонецЦикла;
КонецПроцедуры

&Тест
Процедура БезопасныйHTML_БлокЛюбогоЯзыкаДаётCodeСКлассомЯзыкаВнутриPre() Экспорт
    HTML = Markdown.ВБезопасныйHTML("```bsl
    |Возврат Истина;
    |```
    |
    |```1c
    |Возврат Ложь;
    |```
    |
    |```sdbl
    |ВЫБРАТЬ 1
    |```
    |
    |```1c-query
    |ВЫБРАТЬ 2
    |```
    |
    |```bat
    |echo 1
    |```
    |
    |```sh
    |echo 2
    |```
    |
    |```BSL
    |Возврат Неопределено;
    |```");

    Для Каждого Язык Из СтрРазделить("bsl,1c,sdbl,1c-query,bat,sh,BSL", ",") Цикл
        Утверждения.ПроверитьИстину(СтрНайти(HTML, "<pre><code class=""language-" + Язык + """>") > 0,
            Язык + ": " + HTML);
    КонецЦикла;
КонецПроцедуры
