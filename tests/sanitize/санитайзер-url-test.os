#Использовать "../../src"
#Использовать asserts

// Фильтрация URL в href/src: разрешённые протоколы, относительные пути,
// удаление опасных схем и обфускаций, политика rel для внешних ссылок.

&Тест
Процедура РазрешенныеПротоколыПроходят() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""http://e.com"">x</a>")).Содержит("href=""http://e.com""");
    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""https://e.com"">x</a>")).Содержит("href=""https://e.com""");
    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""mailto:a@b.c"">x</a>")).Содержит("href=""mailto:a@b.c""");

КонецПроцедуры

&Тест
Процедура ОтносительныеПутиПроходят() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""/abs/path"">x</a>")).Содержит("href=""/abs/path""");
    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""./rel"">x</a>")).Содержит("href=""./rel""");
    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""../up"">x</a>")).Содержит("href=""../up""");
    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""docs/a.md"">x</a>")).Содержит("href=""docs/a.md""");
    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""#anchor"">x</a>")).Содержит("href=""#anchor""");
    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""?q=1"">x</a>")).Содержит("href=""?q=1""");

КонецПроцедуры

&Тест
Процедура ДвоеточиеПослеРазделителяПути() Экспорт

    // двоеточие в query/пути — не схема
    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""?time=12:30"">x</a>")).Содержит("href=""?time=12:30""");
    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""/a/b:c"">x</a>")).Содержит("href=""/a/b:c""");

КонецПроцедуры

&Тест
Процедура ПортВРазрешенномURL() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""http://e.com:8080/x"">x</a>"))
        .Содержит("href=""http://e.com:8080/x""");

КонецПроцедуры

&Тест
Процедура ОпасныеСхемыУдаляются() Экспорт

    Схемы = СтрРазделить("javascript:alert(1)|vbscript:msgbox(1)|data:text/html,x|file:///etc/passwd"
        + "|ftp://e.com/x|blob:xxx|filesystem:xxx", "|", Ложь);
    Для Каждого URL Из Схемы Цикл
        Результат = Markdown.ОчиститьHTML("<a href=""" + URL + """>x</a>");
        Ожидаем.Что(Результат, "url: " + URL).Равно("<a>x</a>");
    КонецЦикла;

КонецПроцедуры

&Тест
Процедура СмешанныйРегистрСхемыУдаляется() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""JaVaScRiPt:alert(1)"">x</a>")).Равно("<a>x</a>");
    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""JAVASCRIPT:alert(1)"">x</a>")).Равно("<a>x</a>");

КонецПроцедуры

&Тест
Процедура ОбфускацияУправляющимиУдаляется() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""jav" + Символы.Таб + "ascript:alert(1)"">x</a>"))
        .Равно("<a>x</a>");
    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""jav" + Символы.ПС + "ascript:alert(1)"">x</a>"))
        .Равно("<a>x</a>");
    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""jav" + Символы.ВК + "ascript:alert(1)"">x</a>"))
        .Равно("<a>x</a>");

КонецПроцедуры

&Тест
Процедура ОбфускацияСущностямиУдаляется() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""&#106;avascript:alert(1)"">x</a>")).Равно("<a>x</a>");
    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""&#x6A;avascript:alert(1)"">x</a>")).Равно("<a>x</a>");
    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""javascript&colon;alert(1)"">x</a>")).Равно("<a>x</a>");
    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""jav&Tab;ascript:alert(1)"">x</a>")).Равно("<a>x</a>");
    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""&#106avascript:alert(1)"">x</a>")).Равно("<a>x</a>");

КонецПроцедуры

&Тест
Процедура ДвойноеКодированиеНеРаскодируется() Экспорт

    // &amp;#106; раскодируется ровно один раз — в "&#106;", что не является схемой;
    // такой URL остаётся буквальным текстом и не даёт javascript:
    Результат = Markdown.ОчиститьHTML("<a href=""&amp;#106;avascript:alert(1)"">x</a>");
    Ожидаем.Что(НРег(Результат)).Не_().Содержит("javascript:");

КонецПроцедуры

&Тест
Процедура ПробелВСхемеУдаляетАтрибут() Экспорт

    // пробел не удаляется из схемы, но такая "схема" некорректна — атрибут удаляется
    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""java script:alert(1)"">x</a>")).Равно("<a>x</a>");

КонецПроцедуры

&Тест
Процедура ВедущиеПробелыПередСхемойНеСпасают() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""   javascript:alert(1)"">x</a>")).Равно("<a>x</a>");

КонецПроцедуры

&Тест
Процедура ПротоколОтносительнаяСсылкаВнешняя() Экспорт

    Результат = Markdown.ОчиститьHTML("<a href=""//other.example/x"">x</a>");
    Ожидаем.Что(Результат).Содержит("href=""//other.example/x""");
    Ожидаем.Что(Результат).Содержит("rel=""nofollow noopener""");

КонецПроцедуры

&Тест
Процедура ВнутренниеСсылкиБезRel() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""/local"">x</a>")).Не_().Содержит("rel=");
    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""mailto:a@b.c"">x</a>")).Не_().Содержит("rel=");

КонецПроцедуры

&Тест
Процедура ИзДубликатовАтрибутовДействуетПервый() Экспорт

    // как в браузере: действует первое вхождение атрибута
    Результат = Markdown.ОчиститьHTML("<a href=""javascript:alert(1)"" href=""https://ok.example"">x</a>");
    Ожидаем.Что(НРег(Результат)).Не_().Содержит("javascript");
    Ожидаем.Что(Результат).Не_().Содержит("ok.example");

КонецПроцедуры

&Тест
Процедура DataURIвИзображенииУдаляется() Экспорт

    Результат = Markdown.ОчиститьHTML("<img src=""data:image/png;base64,iVBOR..."" alt=""x"">");
    Ожидаем.Что(Результат).Равно("<img alt=""x""/>");

КонецПроцедуры
