#Использовать "../../src"
#Использовать asserts

// Фасад санитизации: Markdown.ВБезопасныйHTML (рендер + очистка) и Markdown.ОчиститьHTML.
// Проверяется сквозной путь «недоверенный Markdown → безопасный HTML», в том числе
// на пресете, который пропускает сырой HTML, — там санитайзер единственная защита.

#Область ВБезопасныйHTML

&Тест
Процедура ВБезопасныйHTML_ВырезаетСкриптИзСырогоHTML() Экспорт

    // commonmark-пресет пропускает сырой HTML: без санитизации <script> дошёл бы до страницы
    Исходник = "# Пакет" + Символы.ПС + Символы.ПС + "<script>alert(1)</script>";

    Сырой = Markdown.ВHTML(Исходник, Markdown.НастройкиCommonMark());
    Безопасный = Markdown.ВБезопасныйHTML(Исходник, Markdown.НастройкиCommonMark());

    Ожидаем.Что(НРег(Сырой), "пресет действительно пропускает сырой HTML").Содержит("<script>");
    Ожидаем.Что(НРег(Безопасный)).Не_().Содержит("<script");
    Ожидаем.Что(Безопасный).Содержит("<h1>Пакет</h1>");

КонецПроцедуры

&Тест
Процедура ВБезопасныйHTML_ВырезаетОбработчикСобытия() Экспорт

    Исходник = "<div onclick=""evil()"">клик</div>";
    Результат = НРег(Markdown.ВБезопасныйHTML(Исходник, Markdown.НастройкиCommonMark()));

    Ожидаем.Что(Результат).Не_().Содержит("onclick");
    Ожидаем.Что(Результат).Содержит("клик");

КонецПроцедуры

&Тест
Процедура ВБезопасныйHTML_ВырезаетJavascriptСсылкуИзMarkdown() Экспорт

    // ссылка собрана самим markdown-рендером, сырого HTML здесь нет вовсе
    Исходник = "[зло](javascript:alert('L'))" + Символы.ПС + Символы.ПС
        + "![картинка](javascript:alert('I'))";

    Сырой = НРег(Markdown.ВHTML(Исходник));
    Результат = НРег(Markdown.ВБезопасныйHTML(Исходник));

    Ожидаем.Что(Сырой, "рендерер сам по себе схему не фильтрует").Содержит("javascript:");
    Ожидаем.Что(Результат).Не_().Содержит("javascript:");
    Ожидаем.Что(Результат).Содержит("зло");

КонецПроцедуры

&Тест
Процедура ВБезопасныйHTML_СохраняетОбычнуюРазметку() Экспорт

    Исходник = "# Заголовок" + Символы.ПС + Символы.ПС
        + "Абзац с **жирным** и [ссылкой](https://example.com/x)." + Символы.ПС + Символы.ПС
        + "- пункт" + Символы.ПС + "- ещё";

    Результат = Markdown.ВБезопасныйHTML(Исходник);

    Ожидаем.Что(Результат).Содержит("<h1>Заголовок</h1>");
    Ожидаем.Что(Результат).Содержит("<strong>жирным</strong>");
    Ожидаем.Что(Результат).Содержит("href=""https://example.com/x""");
    Ожидаем.Что(Результат).Содержит("rel=""nofollow noopener""");
    Ожидаем.Что(Результат).Содержит("<li>пункт</li>");

КонецПроцедуры

&Тест
Процедура ВБезопасныйHTML_ЗачёркиваниеПереживаетСанитизацию() Экспорт

    // профиль по умолчанию обязан пропускать теги, которые печатает сам рендерер
    Результат = Markdown.ВБезопасныйHTML("~~снято~~", Markdown.НастройкиGitHubLike());

    Ожидаем.Что(Результат).Содержит("<del>снято</del>");

КонецПроцедуры

&Тест
Процедура ВБезопасныйHTML_ТаблицаПереживаетСанитизацию() Экспорт

    Исходник = "| А | Б |" + Символы.ПС + "| --- | ---: |" + Символы.ПС + "| 1 | 2 |";
    Результат = Markdown.ВБезопасныйHTML(Исходник, Markdown.НастройкиGitHubLike());

    Ожидаем.Что(Результат).Содержит("<table>");
    Ожидаем.Что(Результат).Содержит("<th>А</th>");
    Ожидаем.Что(Результат).Содержит("align=""right""");

КонецПроцедуры

&Тест
Процедура ВБезопасныйHTML_ПринимаетСвойAllowlist() Экспорт

    Результат = Markdown.ВБезопасныйHTML("# Заголовок", Неопределено,
        Markdown.ПустыеНастройкиСанитизации());

    Ожидаем.Что(Результат).Не_().Содержит("<h1>");
    Ожидаем.Что(Результат).Содержит("Заголовок");

КонецПроцедуры

&Тест
Процедура ВБезопасныйHTML_ПустойВход() Экспорт

    Ожидаем.Что(Markdown.ВБезопасныйHTML("")).Равно("");

КонецПроцедуры

#КонецОбласти

#Область ОчиститьHTML

&Тест
Процедура ОчиститьHTML_ПрофильПоУмолчаниюНезависимМеждуВызовами() Экспорт

    // профиль отдаётся новым объектом: правка одного вызова не отравляет соседний
    Свой = Markdown.НастройкиСанитизацииПоУмолчанию().ЗапретитьТег("strong");

    Ожидаем.Что(Markdown.ОчиститьHTML("<p><strong>ж</strong></p>", Свой)).Равно("<p>ж</p>");
    Ожидаем.Что(Markdown.ОчиститьHTML("<p><strong>ж</strong></p>")).Равно("<p><strong>ж</strong></p>");

КонецПроцедуры

&Тест
Процедура ОчиститьHTML_ПустойЭлементВходаНеЛоматьВложенность() Экспорт

    // input — void-элемент: он не должен уезжать в стек открытых тегов и обрастать </input>
    Настройки = Markdown.НастройкиСанитизацииПоУмолчанию()
        .РазрешитьТег("input", "type, checked, disabled");

    Результат = Markdown.ОчиститьHTML("<ul><li><input disabled="""" type=""checkbox""> дело</li></ul>",
        Настройки);

    Ожидаем.Что(Результат).Не_().Содержит("</input>");
    Ожидаем.Что(Результат).Равно("<ul><li><input disabled="""" type=""checkbox""/> дело</li></ul>");

КонецПроцедуры

&Тест
Процедура ОчиститьHTML_ТипВходаКромеЧекбоксаУдаляется() Экспорт

    Настройки = Markdown.НастройкиСанитизацииПоУмолчанию()
        .РазрешитьТег("input", "type, checked, disabled");

    Ожидаем.Что(Markdown.ОчиститьHTML("<input type=""image"">", Настройки)).Равно("<input/>");
    Ожидаем.Что(Markdown.ОчиститьHTML("<input type=""password"">", Настройки)).Равно("<input/>");
    Ожидаем.Что(Markdown.ОчиститьHTML("<input type=""CheckBox"">", Настройки))
        .Равно("<input type=""checkbox""/>");

КонецПроцедуры

#КонецОбласти
