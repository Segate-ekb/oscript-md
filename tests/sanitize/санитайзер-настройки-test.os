#Использовать "../../src"
#Использовать asserts

// Конфигурируемость: свои allowlist, управление протоколами и rel.

&Тест
Процедура ПустыеНастройкиУбираютВсеТеги() Экспорт

    Настройки = Markdown.ПустыеНастройкиСанитизации();
    Ожидаем.Что(Markdown.ОчиститьHTML("<p>текст <strong>жирный</strong></p>", Настройки))
        .Равно("текст жирный");

КонецПроцедуры

&Тест
Процедура СвойAllowlist() Экспорт

    Настройки = Markdown.ПустыеНастройкиСанитизации()
        .РазрешитьТег("b")
        .РазрешитьТег("span", "title");

    Результат = Markdown.ОчиститьHTML("<b>ж</b><span title=""т"" class=""x"">с</span><p>абзац</p>", Настройки);
    Ожидаем.Что(Результат).Равно("<b>ж</b><span title=""т"">с</span>абзац");

КонецПроцедуры

&Тест
Процедура АтрибутыМассивом() Экспорт

    Атрибуты = Новый Массив;
    Атрибуты.Добавить("href");
    Атрибуты.Добавить("title");
    Настройки = Markdown.ПустыеНастройкиСанитизации().РазрешитьТег("a", Атрибуты);

    Результат = Markdown.ОчиститьHTML("<a href=""/x"" title=""т"" id=""z"">с</a>", Настройки);
    Ожидаем.Что(Результат).Равно("<a href=""/x"" title=""т"">с</a>");

КонецПроцедуры

&Тест
Процедура ЗапретТегаИзПрофиля() Экспорт

    Настройки = Markdown.НастройкиСанитизацииПоУмолчанию().ЗапретитьТег("img");
    Результат = Markdown.ОчиститьHTML("<p>до <img src=""https://e/x.png""> после</p>", Настройки);
    Ожидаем.Что(Результат).Равно("<p>до  после</p>");

КонецПроцедуры

&Тест
Процедура УдалениеТегаССодержимымПоНастройке() Экспорт

    Настройки = Markdown.НастройкиСанитизацииПоУмолчанию().УдалятьТегССодержимым("blockquote");
    Результат = Markdown.ОчиститьHTML("<p>до</p><blockquote>цитата</blockquote><p>после</p>", Настройки);
    Ожидаем.Что(Результат).Равно("<p>до</p><p>после</p>");

КонецПроцедуры

&Тест
Процедура ОтключениеRel() Экспорт

    Настройки = Markdown.НастройкиСанитизацииПоУмолчанию().УстановитьRelВнешнихСсылок("");
    Результат = Markdown.ОчиститьHTML("<a href=""https://e.com"">x</a>", Настройки);
    Ожидаем.Что(Результат).Равно("<a href=""https://e.com"">x</a>");

КонецПроцедуры

&Тест
Процедура СвоеЗначениеRel() Экспорт

    Настройки = Markdown.НастройкиСанитизацииПоУмолчанию()
        .УстановитьRelВнешнихСсылок("nofollow noopener noreferrer");
    Результат = Markdown.ОчиститьHTML("<a href=""https://e.com"">x</a>", Настройки);
    Ожидаем.Что(Результат).Содержит("rel=""nofollow noopener noreferrer""");

КонецПроцедуры

&Тест
Процедура ДополнительныйПротокол() Экспорт

    Настройки = Markdown.НастройкиСанитизацииПоУмолчанию().РазрешитьПротокол("ftp");
    Результат = Markdown.ОчиститьHTML("<a href=""ftp://files.example/x"">x</a>", Настройки);
    Ожидаем.Что(Результат).Содержит("href=""ftp://files.example/x""");

КонецПроцедуры

&Тест
Процедура ЗапретПротокола() Экспорт

    Настройки = Markdown.НастройкиСанитизацииПоУмолчанию().ЗапретитьПротокол("http");
    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""http://e.com"">x</a>", Настройки)).Равно("<a>x</a>");
    Ожидаем.Что(Markdown.ОчиститьHTML("<a href=""https://e.com"">x</a>", Настройки))
        .Содержит("href=""https://e.com""");

КонецПроцедуры

&Тест
Процедура РазрешениеРанееОпасногоТега() Экспорт

    // разрешение тега снимает с него пометку "удалять с содержимым"
    Настройки = Markdown.НастройкиСанитизацииПоУмолчанию().РазрешитьТег("form");
    Результат = Markdown.ОчиститьHTML("<form action=""x"">содержимое</form>", Настройки);
    Ожидаем.Что(Результат).Равно("<form>содержимое</form>");

КонецПроцедуры

&Тест
Процедура НекорректныйКлассКодаУдаляется() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("<code class=""evil"">x</code>")).Равно("<code>x</code>");
    Ожидаем.Что(Markdown.ОчиститьHTML("<code class=""language-"">x</code>")).Равно("<code>x</code>");
    Ожидаем.Что(Markdown.ОчиститьHTML("<code class=""language-js evil"">x</code>")).Равно("<code>x</code>");
    Ожидаем.Что(Markdown.ОчиститьHTML("<code class=""language-c++"">x</code>"))
        .Равно("<code class=""language-c++"">x</code>");

КонецПроцедуры

&Тест
Процедура НекорректноеВыравниваниеУдаляется() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("<table><tr><td align=""evil"">x</td></tr></table>"))
        .Равно("<table><tr><td>x</td></tr></table>");

КонецПроцедуры

&Тест
Процедура СанитайзерТребуетНастройки() Экспорт

    Ошибка = Ложь;
    Попытка
        Санитайзер = Новый MarkdownHTMLСанитайзер("не настройки");
    Исключение
        Ошибка = Истина;
    КонецПопытки;
    Ожидаем.Что(Ошибка).ЭтоИстина();

КонецПроцедуры
