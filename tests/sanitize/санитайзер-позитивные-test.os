#Использовать "../../src"
#Использовать asserts

// Позитивные тесты: валидный HTML, порождаемый markdown-рендером,
// проходит санитизацию без искажений.

&Тест
Процедура АбзацИФорматирование() Экспорт

    HTML = "<p>Привет, <strong>мир</strong> и <em>все-все</em>!</p>";
    Ожидаем.Что(Markdown.ОчиститьHTML(HTML)).Равно(HTML);

КонецПроцедуры

&Тест
Процедура ЗаголовкиВсехУровней() Экспорт

    HTML = "<h1>1</h1><h2>2</h2><h3>3</h3><h4>4</h4><h5>5</h5><h6>6</h6>";
    Ожидаем.Что(Markdown.ОчиститьHTML(HTML)).Равно(HTML);

КонецПроцедуры

&Тест
Процедура Списки() Экспорт

    HTML = "<ul><li>один</li><li>два</li></ul><ol><li>раз</li><li>два</li></ol>";
    Ожидаем.Что(Markdown.ОчиститьHTML(HTML)).Равно(HTML);

КонецПроцедуры

&Тест
Процедура ЦитатаИРазделитель() Экспорт

    HTML = "<blockquote><p>цитата</p></blockquote><hr/>";
    Ожидаем.Что(Markdown.ОчиститьHTML("<blockquote><p>цитата</p></blockquote><hr>")).Равно(HTML);

КонецПроцедуры

&Тест
Процедура ПереносСтроки() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("<p>раз<br>два</p>")).Равно("<p>раз<br/>два</p>");

КонецПроцедуры

&Тест
Процедура ВнешняяСсылкаПолучаетRel() Экспорт

    Результат = Markdown.ОчиститьHTML("<a href=""https://example.com/x"" title=""т"">пример</a>");
    Ожидаем.Что(Результат)
        .Равно("<a href=""https://example.com/x"" title=""т"" rel=""nofollow noopener"">пример</a>");

КонецПроцедуры

&Тест
Процедура ОтносительнаяСсылкаБезRel() Экспорт

    HTML = "<a href=""/docs/readme"">внутренняя</a>";
    Ожидаем.Что(Markdown.ОчиститьHTML(HTML)).Равно(HTML);

КонецПроцедуры

&Тест
Процедура ЯкорнаяСсылкаБезИзменений() Экспорт

    HTML = "<a href=""#section-1"">якорь</a>";
    Ожидаем.Что(Markdown.ОчиститьHTML(HTML)).Равно(HTML);

КонецПроцедуры

&Тест
Процедура СсылкаMailto() Экспорт

    HTML = "<a href=""mailto:dev@example.com"">почта</a>";
    Ожидаем.Что(Markdown.ОчиститьHTML(HTML)).Равно(HTML);

КонецПроцедуры

&Тест
Процедура Изображение() Экспорт

    Результат = Markdown.ОчиститьHTML("<img src=""https://example.com/logo.png"" alt=""лого"" title=""т"">");
    Ожидаем.Что(Результат).Равно("<img src=""https://example.com/logo.png"" alt=""лого"" title=""т""/>");

КонецПроцедуры

&Тест
Процедура БлокКодаСЯзыком() Экспорт

    HTML = "<pre><code class=""language-bsl"">Сообщить(1)</code></pre>";
    Ожидаем.Что(Markdown.ОчиститьHTML(HTML)).Равно(HTML);

КонецПроцедуры

&Тест
Процедура ВстроенныйКод() Экспорт

    HTML = "<p>вызов <code>opm install</code> установит пакет</p>";
    Ожидаем.Что(Markdown.ОчиститьHTML(HTML)).Равно(HTML);

КонецПроцедуры

&Тест
Процедура ТаблицаСВыравниванием() Экспорт

    HTML = "<table><thead><tr><th align=""left"">А</th><th align=""right"">Б</th></tr></thead>"
        + "<tbody><tr><td align=""center"">1</td><td>2</td></tr></tbody></table>";
    Ожидаем.Что(Markdown.ОчиститьHTML(HTML)).Равно(HTML);

КонецПроцедуры

&Тест
Процедура DetailsSummary() Экспорт

    HTML = "<details><summary>Подробности</summary><p>текст</p></details>";
    Ожидаем.Что(Markdown.ОчиститьHTML(HTML)).Равно(HTML);

КонецПроцедуры

&Тест
Процедура ЭкранированныеСущностиСохраняются() Экспорт

    // &lt;script&gt; в тексте — это просто текст, он должен остаться экранированным
    HTML = "<p>&lt;script&gt; — это тег</p>";
    Результат = Markdown.ОчиститьHTML(HTML);
    Ожидаем.Что(Результат).Содержит("&lt;script&gt;");
    Ожидаем.Что(Результат).Не_().Содержит("<script");

КонецПроцедуры

&Тест
Процедура ТипографскиеСущностиРаскодируются() Экспорт

    Результат = Markdown.ОчиститьHTML("<p>тире &mdash; и &laquo;кавычки&raquo;</p>");
    Ожидаем.Что(Результат).Равно("<p>тире " + Символ(8212) + " и " + Символ(171) + "кавычки" + Символ(187) + "</p>");

КонецПроцедуры

&Тест
Процедура АмперсандВТексте() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("<p>A &amp; B</p>")).Равно("<p>A &amp; B</p>");

КонецПроцедуры

&Тест
Процедура ПустаяСтрокаИНеопределено() Экспорт

    Ожидаем.Что(Markdown.ОчиститьHTML("")).Равно("");
    Ожидаем.Что(Markdown.ОчиститьHTML(Неопределено)).Равно("");

КонецПроцедуры

&Тест
Процедура ТипичныйREADME() Экспорт

    HTML = "<h1>Библиотека</h1><p>Установка: <code>opm install lib</code></p>"
        + "<h2>Пример</h2><pre><code class=""language-bsl"">Перем А;</code></pre>"
        + "<ul><li><a href=""https://github.com/x/y"">репозиторий</a></li></ul>";
    Результат = Markdown.ОчиститьHTML(HTML);
    Ожидаем.Что(Результат).Содержит("<h1>Библиотека</h1>");
    Ожидаем.Что(Результат).Содержит("<code class=""language-bsl"">");
    Ожидаем.Что(Результат).Содержит("rel=""nofollow noopener""");

КонецПроцедуры
