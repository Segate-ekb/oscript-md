#Использовать asserts
#Использовать 1commands
#Использовать "../../src"

// Подсветка кода на настоящей странице: Chrome без окна открывает HTML из Markdown с тегом
// подсветки, ждёт, пока отработают скрипты, и отдаёт получившийся DOM. Нужны Chrome
// (google-chrome в PATH или путь в CHROME_BIN) и доступ к esm.sh.

&Тест
&Таймаут(120000)
Процедура Chrome_РаскрашиваетБлокиBSLИЗапросовИЗапросВСтроке() Экспорт
    DOM = DOMСтраницыПослеСкриптов(Markdown.ВБезопасныйHTML("```bsl
    |Запрос = Новый Запрос(""ВЫБРАТЬ Ссылка ИЗ Справочник.Товары"");
    |```
    |
    |```1c
    |Возврат Ложь;
    |```
    |
    |```sdbl
    |ВЫБРАТЬ 1
    |```
    |
    |```1c-query
    |ВЫБРАТЬ 2
    |```") + MarkdownПодсветка.ТегСкрипта());
    Блоки = РаскрашенныеБлоки(DOM);

    Утверждения.ПроверитьРавенство(Блоки.Количество(), 4,
        "Блоки bsl, 1c, sdbl и 1c-query должны стать разметкой shiki: " + DOM);
    Утверждения.ПроверитьИстину(СтрНайти(Блоки[0], ">ВЫБРАТЬ</span>") > 0,
        "Запрос в строке кода BSL должен раскраситься отдельными словами: " + DOM);
КонецПроцедуры

&Тест
&Таймаут(120000)
Процедура Chrome_РаскрашиваетBatИShКакЛюбойЯзыкИзРеестраShiki() Экспорт
    DOM = DOMСтраницыПослеСкриптов(Markdown.ВБезопасныйHTML("```bat
    |@echo off
    |echo Привет
    |```
    |
    |```sh
    |for f in *.os; do echo ""$f""; done
    |```") + MarkdownПодсветка.ТегСкрипта());
    Блоки = РаскрашенныеБлоки(DOM);

    Утверждения.ПроверитьРавенство(Блоки.Количество(), 2,
        "Блоки bat и sh должны стать разметкой shiki: " + DOM);
    Утверждения.ПроверитьИстину(СтрНайти(Блоки[0], ">echo</span>") > 0,
        "Команда bat должна раскраситься отдельным словом: " + DOM);
    Утверждения.ПроверитьИстину(СтрНайти(Блоки[1], ">for</span>") > 0,
        "Ключевое слово sh должно раскраситься отдельным словом: " + DOM);
КонецПроцедуры

&Тест
&Таймаут(120000)
Процедура Chrome_БлокНаНезнакомомЯзыкеОстаётсяТекстомИНеМешаетСледующим() Экспорт
    DOM = DOMСтраницыПослеСкриптов(Markdown.ВБезопасныйHTML("```nosuchlang
    |не язык
    |```
    |
    |```constructor
    |имя свойства любого объекта JavaScript
    |```
    |
    |```__proto__
    |и это тоже
    |```
    |
    |```bsl
    |Возврат Истина;
    |```") + MarkdownПодсветка.ТегСкрипта());

    Для Каждого Язык Из СтрРазделить("nosuchlang,constructor,__proto__", ",") Цикл
        Утверждения.ПроверитьИстину(СтрНайти(DOM, "<pre><code class=""language-" + Язык + """>") > 0,
            "Блок " + Язык + " должен остаться как был: " + DOM);
    КонецЦикла;
    Утверждения.ПроверитьРавенство(РаскрашенныеБлоки(DOM).Количество(), 1,
        "Блок bsl после незнакомых языков должен раскраситься: " + DOM);
КонецПроцедуры

&Тест
&Таймаут(120000)
Процедура Chrome_ЯзыкЗаглавнымиБуквамиРаскрашиваетсяКакСтрочными() Экспорт
    DOM = DOMСтраницыПослеСкриптов(Markdown.ВБезопасныйHTML("```BSL
    |Возврат Истина;
    |```") + MarkdownПодсветка.ТегСкрипта());

    Утверждения.ПроверитьРавенство(РаскрашенныеБлоки(DOM).Количество(), 1,
        "Блок BSL должен раскраситься как bsl: " + DOM);
КонецПроцедуры

&Тест
&Таймаут(120000)
Процедура Chrome_БезТемыСловаНесутЦветаОбеихТемЧерезLightDark() Экспорт
    DOM = DOMСтраницыПослеСкриптов(Markdown.ВБезопасныйHTML("```bsl
    |Возврат Истина;
    |```") + MarkdownПодсветка.ТегСкрипта());

    Утверждения.ПроверитьИстину(СтрНайти(DOM, "<span style=""color:light-dark(") > 0,
        "Слова кода должны нести цвета обеих тем, чтобы браузер выбрал по color-scheme: " + DOM);
КонецПроцедуры

&Тест
&Таймаут(120000)
Процедура Chrome_СТемойDarkКраситВЦветаТёмнойТемыGitHub() Экспорт
    DOM = DOMСтраницыПослеСкриптов(Markdown.ВБезопасныйHTML("```bsl
    |Возврат Истина;
    |```") + MarkdownПодсветка.ТегСкрипта("dark"));

    Утверждения.ПроверитьИстину(СтрНайти(DOM, "style=""background-color:#24292e;") > 0,
        "Блок bsl должен раскраситься в цвета тёмной темы GitHub: " + DOM);
    Утверждения.ПроверитьЛожь(СтрНайти(DOM, "light-dark(") > 0,
        "Тема зафиксирована, выбор браузеру не отдаётся: " + DOM);
КонецПроцедуры

Функция DOMСтраницыПослеСкриптов(Знач Тело)
    ФайлСтраницы = ПолучитьИмяВременногоФайла("html");
    Запись = Новый ЗаписьТекста(ФайлСтраницы, КодировкаТекста.UTF8);
    Запись.Записать("<!doctype html><meta charset=""utf-8"">" + Тело);
    Запись.Закрыть();

    Команда = Новый Команда;
    Команда.УстановитьКоманду(Браузер());
    Команда.ДобавитьПараметр("--headless");
    // виртуальное время ждёт только сеть и главный поток: без фоновых потоков V8 компиляция
    // WebAssembly движка shiki идёт в главном, и DOM не снимается до подсветки
    Команда.ДобавитьПараметр("--js-flags=--single-threaded");
    Команда.ДобавитьПараметр("--virtual-time-budget=60000");
    Команда.ДобавитьПараметр("--dump-dom");
    Команда.ДобавитьПараметр(ФайлСтраницы);
    Команда.УстановитьКодировкуВывода("utf-8");

    КодВозврата = Команда.Исполнить();
    Вывод = Команда.ПолучитьВывод();
    УдалитьФайлы(ФайлСтраницы);

    Утверждения.ПроверитьРавенство(КодВозврата, 0, Вывод);
    Утверждения.ПроверитьЛожь(СтрНайти(Вывод, "unrecognized flag") > 0,
        "Chrome не знает флаг V8 из --js-flags: " + Вывод);
    Возврат Вывод;
КонецФункции

Функция Браузер()
    Путь = ПолучитьПеременнуюСреды("CHROME_BIN");
    Возврат ?(ЗначениеЗаполнено(Путь), Путь, "google-chrome");
КонецФункции

// разметка блоков shiki в порядке на странице
Функция РаскрашенныеБлоки(Знач DOM)
    Блоки = Новый Массив;
    Начало = СтрНайти(DOM, "<pre class=""shiki");
    Пока Начало > 0 Цикл
        Конец = СтрНайти(DOM, "</pre>", , Начало);
        Блоки.Добавить(Сред(DOM, Начало, Конец - Начало));
        Начало = СтрНайти(DOM, "<pre class=""shiki", , Конец);
    КонецЦикла;
    Возврат Блоки;
КонецФункции
