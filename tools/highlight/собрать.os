// Сборка движка подсветки кода из OneScript: npm ci по package-lock.json и npm run build
// в каталоге этого сценария. Её зовут хук ПередСборкой в packagedef (opm build) и задачи
// tasks/test*.os. Только встроенные средства OneScript 2.0: при opm build в релизе
// dev-зависимостей пакета нет.

// Ставит зависимости ровно по package-lock.json и собирает движок в src/highlight.
// Без node 20+ с npm в PATH или без доступа к реестру npm бросает исключение, которое
// называет команду, каталог и то, чем она кончилась.
Процедура СобратьДвижок() Экспорт
    Каталог = Новый Файл(ТекущийСценарий().Каталог).ПолноеИмя;

    Версия = ВерсияNode();
    Если Версия < 20 Тогда
        ВызватьИсключение ОписаниеОтказа("node --version", Каталог,
            ?(Версия = 0, "node не запустился", СтрШаблон("нашёлся node %1", Версия)));
    КонецЕсли;

    ЗапуститьNpm("ci --no-audit --no-fund", Каталог);
    ЗапуститьNpm("run build", Каталог);
КонецПроцедуры

// Старшая версия node, который найдётся в PATH.
//
// Возвращаемое значение:
//   Число - например, 22 для v22.22.2; 0 — node не запустился или ответил не версией
Функция ВерсияNode() Экспорт
    Попытка
        Процесс = СоздатьПроцесс(СтрокаЗапуска("node --version"), , Истина);
        Процесс.Запустить();
        Процесс.ОжидатьЗавершения();
        Ответ = СокрЛП(Процесс.ПотокВывода.Прочитать());
    Исключение
        Возврат 0;
    КонецПопытки;

    Если Процесс.КодВозврата <> 0 Или Не СтрНачинаетсяС(Ответ, "v") Тогда
        Возврат 0;
    КонецЕсли;

    // v22.22.2 → 22
    Попытка
        Возврат Число(СтрРазделить(Сред(Ответ, 2), ".")[0]);
    Исключение
        Возврат 0;
    КонецПопытки;
КонецФункции

// Вывод npm не перехватывается: он идёт прямо в лог сборки
Процедура ЗапуститьNpm(Аргументы, Каталог)
    Команда = "npm " + Аргументы;
    КодВозврата = 0;
    Попытка
        ЗапуститьПриложение(СтрокаЗапуска(Команда), Каталог, Истина, КодВозврата);
    Исключение
        ВызватьИсключение ОписаниеОтказа(Команда, Каталог,
            "не запустилась: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;

    Если КодВозврата <> 0 Тогда
        ВызватьИсключение ОписаниеОтказа(Команда, Каталог, СтрШаблон("код возврата %1", КодВозврата));
    КонецЕсли;
КонецПроцедуры

// npm и node на Windows могут оказаться .cmd-обёртками: их запускает только командный процессор
Функция СтрокаЗапуска(Команда)
    СистемнаяИнформация = Новый СистемнаяИнформация;
    Если СтрНайти(НРег(СистемнаяИнформация.ВерсияОС), "windows") > 0 Тогда
        Возврат "cmd /c " + Команда;
    КонецЕсли;
    Возврат Команда;
КонецФункции

Функция ОписаниеОтказа(Команда, Каталог, Итог)
    Возврат СтрШаблон("Движок подсветки кода не собран: «%1» в каталоге %2 — %3. "
        + "Нужен node 20+ с npm в PATH и доступ к реестру npm; движок собирает "
        + "`npm ci && npm run build` в tools/highlight.", Команда, Каталог, Итог);
КонецФункции
