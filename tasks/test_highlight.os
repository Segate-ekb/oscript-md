// Сборка и тесты скрипта подсветки кода: npm ci по package-lock.json и npm test
// в tools/highlight. Нужен node с npm.
//
// Запуск:
//   oscript tasks/test_highlight.os
//
// Выход: 0 при успехе, !=0 при падении.

#Использовать 1commands

Для Каждого Аргументы Из СтрРазделить("ci --no-audit --no-fund|test", "|") Цикл
    Команда = Новый Команда;
    Команда.УстановитьКоманду("npm");
    Команда.ДобавитьПараметр(Аргументы);
    Команда.УстановитьРабочийКаталог(ОбъединитьПути(".", "tools", "highlight"));
    Команда.ПоказыватьВыводНемедленно(Истина);

    Если Команда.Исполнить() <> 0 Тогда
        ВызватьИсключение "Тесты скрипта подсветки кода завершились неудачно: npm " + Аргументы;
    КонецЕсли;
КонецЦикла;
