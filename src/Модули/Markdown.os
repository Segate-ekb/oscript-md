// Фасад библиотеки. Все типичные сценарии — через пять функций:
//   Markdown.ВHTML(текст[, настройки])            → HTML
//   Markdown.ВБезопасныйHTML(текст[, настройки])  → HTML, санитизированный по allowlist
//   Markdown.Разобрать(текст[, настройки])        → MarkdownДокумент
//   Markdown.ВJSON(текст[, настройки])            → JSON
//   Markdown.ВТекст(текст[, настройки])           → plain text
//
// Санитизацию выполняет библиотека html-sanitizer — здесь только вызов её фасада.

#Использовать html-sanitizer

// Подключаем семантические подпапки библиотеки.
// Стандартный загрузчик OneScript видит только src/Классы и src/Модули, поэтому
// классы из вложенных папок (ast/, rendering/, extensions/, internal/*)
// регистрируются явно через #Использовать. Фасад — самая ранняя точка загрузки,
// поэтому подключение всех подпапок здесь гарантирует, что любой класс библиотеки
// доступен сразу после `#Использовать "oscript-md"`.
#Использовать "../ast"
#Использовать "../rendering"
#Использовать "../extensions"
#Использовать "../internal/parsing"
#Использовать "../internal/block"
#Использовать "../internal/extensions"
#Использовать "../internal/inline"

Функция ВHTML(Знач Текст, Настройки = Неопределено) Экспорт
    Док = Разобрать(Текст, Настройки);
    Рендерер = Новый MarkdownHTMLРендерер(ОбеспечитьНастройки(Настройки));
    Возврат Рендерер.Отрендерить(Док);
КонецФункции

// Рендерит недоверенный Markdown в HTML, безопасный для вставки в страницу:
// результат ВHTML пропускается через санитизацию html-sanitizer по allowlist.
//
// Параметры:
//   Текст                - Строка - исходный Markdown (недоверенный)
//   Настройки            - MarkdownНастройки - настройки парсера/рендерера
//   НастройкиСанитизации - НастройкиСанитизации - allowlist html-sanitizer;
//                          по умолчанию — НастройкиСанитизацииПоУмолчанию()
//
// Возвращаемое значение:
//   Строка - санитизированный HTML
Функция ВБезопасныйHTML(Знач Текст, Настройки = Неопределено, НастройкиСанитизации = Неопределено) Экспорт
    Возврат ОчиститьHTML(ВHTML(Текст, Настройки), НастройкиСанитизации);
КонецФункции

// Санитизирует готовый HTML по allowlist (html-sanitizer): неразрешённые теги и
// атрибуты удаляются, текст и значения атрибутов экранируются, URL проверяются по схеме.
//
// Параметры:
//   HTML      - Строка - недоверенный HTML
//   Настройки - НастройкиСанитизации - allowlist html-sanitizer;
//               по умолчанию — НастройкиСанитизацииПоУмолчанию()
//
// Возвращаемое значение:
//   Строка - безопасный HTML
Функция ОчиститьHTML(Знач HTML, Настройки = Неопределено) Экспорт
    Возврат СанитизацияHTML.Очистить(HTML, ОбеспечитьНастройкиСанитизации(Настройки));
КонецФункции

// Профиль санитизации по умолчанию — allowlist под вывод MarkdownHTMLРендерер.
// Базовый профиль html-sanitizer плюс теги GFM-расширений, которые печатает
// рендерер этой библиотеки: <del> зачёркивания и <input> чекбокса списка задач
// (без них ~~текст~~ теряет разметку, а `- [x]` — сам чекбокс).
// Возвращает новый объект: правка одного вызова не отражается на соседних.
//
// Возвращаемое значение:
//   НастройкиСанитизации - allowlist html-sanitizer, готовый к доработке цепочкой
Функция НастройкиСанитизацииПоУмолчанию() Экспорт
    Возврат СанитизацияHTML.НастройкиMarkdown()
        .РазрешитьТег("del")
        .РазрешитьТег("input", "type, checked, disabled");
КонецФункции

Функция Разобрать(Знач Текст, Настройки = Неопределено) Экспорт
    Парсер = Новый MarkdownПарсер(ОбеспечитьНастройки(Настройки));
    Возврат Парсер.Разобрать(Текст);
КонецФункции

Функция ВJSON(Знач Текст, Настройки = Неопределено) Экспорт
    Док = Разобрать(Текст, Настройки);
    Рендерер = Новый MarkdownJSONРендерер();
    Возврат Рендерер.Отрендерить(Док);
КонецФункции

Функция ВТекст(Знач Текст, Настройки = Неопределено) Экспорт
    Док = Разобрать(Текст, Настройки);
    Рендерер = Новый MarkdownТекстовыйРендерер();
    Возврат Рендерер.Отрендерить(Док);
КонецФункции

Функция НастройкиПоУмолчанию() Экспорт
    Возврат Новый MarkdownНастройки();
КонецФункции

Функция НастройкиCommonMark() Экспорт
    Возврат Новый MarkdownНастройки("commonmark");
КонецФункции

Функция НастройкиGitHubLike() Экспорт
    Возврат Новый MarkdownНастройки("github-like");
КонецФункции

Функция НастройкиДокументация() Экспорт
    Возврат Новый MarkdownНастройки("documentation");
КонецФункции

Функция ОбеспечитьНастройки(Настройки)
    Если Настройки = Неопределено Тогда
        Возврат Новый MarkdownНастройки();
    КонецЕсли;
    Возврат Настройки;
КонецФункции

Функция ОбеспечитьНастройкиСанитизации(Настройки)
    Если Настройки = Неопределено Тогда
        Возврат НастройкиСанитизацииПоУмолчанию();
    КонецЕсли;
    Возврат Настройки;
КонецФункции
