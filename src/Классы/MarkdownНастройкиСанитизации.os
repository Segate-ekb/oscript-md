// MarkdownНастройкиСанитизации — конфигурация санитайзера: allowlist тегов и
// атрибутов, разрешённые протоколы URL, политика rel для внешних ссылок.
//
// Новый объект не разрешает ни одного тега (принцип allowlist). Готовые профили —
// у фасада: Markdown.НастройкиСанитизацииПоУмолчанию(), Markdown.ПустыеНастройкиСанитизации().

Перем мРазрешенныеТеги;       // Соответствие: имя тега -> Соответствие разрешённых атрибутов
Перем мТегиСОпаснымСодержимым; // Соответствие: имя тега -> Истина (удалять вместе с содержимым)
Перем мРазрешенныеПротоколы;  // Соответствие: схема URL -> Истина
Перем мRelВнешнихСсылок;      // Строка: значение rel для внешних ссылок ("" — не добавлять)

// Разрешает тег и (опционально) его атрибуты.
//
// Параметры:
//   Имя       - Строка - имя тега (регистр не важен)
//   Атрибуты  - Строка, Массив - разрешённые атрибуты: строка через запятую
//               ("href, title") или массив строк; по умолчанию — без атрибутов
//
// Возвращаемое значение:
//   MarkdownНастройкиСанитизации - этот же объект (для цепочки вызовов)
Функция РазрешитьТег(Знач Имя, Знач Атрибуты = "") Экспорт

    Имя = НРег(СокрЛП(Имя));

    СписокАтрибутов = Атрибуты;
    Если ТипЗнч(Атрибуты) = Тип("Строка") Тогда
        СписокАтрибутов = СтрРазделить(Атрибуты, ",", Ложь);
    КонецЕсли;

    СоответствиеАтрибутов = Новый Соответствие;
    Для Каждого Атрибут Из СписокАтрибутов Цикл
        СоответствиеАтрибутов.Вставить(НРег(СокрЛП(Атрибут)), Истина);
    КонецЦикла;

    мРазрешенныеТеги.Вставить(Имя, СоответствиеАтрибутов);
    мТегиСОпаснымСодержимым.Удалить(Имя);

    Возврат ЭтотОбъект;

КонецФункции

// Запрещает ранее разрешённый тег (сам тег удаляется, содержимое остаётся).
//
// Параметры:
//   Имя - Строка - имя тега
//
// Возвращаемое значение:
//   MarkdownНастройкиСанитизации - этот же объект
Функция ЗапретитьТег(Знач Имя) Экспорт

    мРазрешенныеТеги.Удалить(НРег(СокрЛП(Имя)));
    Возврат ЭтотОбъект;

КонецФункции

// Помечает тег как удаляемый вместе со всем содержимым (как script/style).
//
// Параметры:
//   Имя - Строка - имя тега
//
// Возвращаемое значение:
//   MarkdownНастройкиСанитизации - этот же объект
Функция УдалятьТегССодержимым(Знач Имя) Экспорт

    Имя = НРег(СокрЛП(Имя));
    мТегиСОпаснымСодержимым.Вставить(Имя, Истина);
    мРазрешенныеТеги.Удалить(Имя);

    Возврат ЭтотОбъект;

КонецФункции

// Разрешает дополнительный протокол URL для href/src.
//
// Параметры:
//   Схема - Строка - схема без двоеточия, например "ftp"
//
// Возвращаемое значение:
//   MarkdownНастройкиСанитизации - этот же объект
Функция РазрешитьПротокол(Знач Схема) Экспорт

    мРазрешенныеПротоколы.Вставить(НРег(СокрЛП(Схема)), Истина);
    Возврат ЭтотОбъект;

КонецФункции

// Запрещает протокол URL.
//
// Параметры:
//   Схема - Строка - схема без двоеточия
//
// Возвращаемое значение:
//   MarkdownНастройкиСанитизации - этот же объект
Функция ЗапретитьПротокол(Знач Схема) Экспорт

    мРазрешенныеПротоколы.Удалить(НРег(СокрЛП(Схема)));
    Возврат ЭтотОбъект;

КонецФункции

// Устанавливает значение атрибута rel, добавляемого внешним ссылкам.
//
// Параметры:
//   Значение - Строка - значение rel; пустая строка отключает добавление
//
// Возвращаемое значение:
//   MarkdownНастройкиСанитизации - этот же объект
Функция УстановитьRelВнешнихСсылок(Знач Значение) Экспорт

    мRelВнешнихСсылок = СокрЛП(Значение);
    Возврат ЭтотОбъект;

КонецФункции

// Проверяет, разрешён ли тег.
//
// Параметры:
//   Имя - Строка - имя тега (нижний регистр)
//
// Возвращаемое значение:
//   Булево
Функция ТегРазрешен(Знач Имя) Экспорт

    Возврат мРазрешенныеТеги.Получить(Имя) <> Неопределено;

КонецФункции

// Проверяет, разрешён ли атрибут у тега.
//
// Параметры:
//   Тег     - Строка - имя тега (нижний регистр)
//   Атрибут - Строка - имя атрибута (нижний регистр)
//
// Возвращаемое значение:
//   Булево
Функция АтрибутРазрешен(Знач Тег, Знач Атрибут) Экспорт

    СоответствиеАтрибутов = мРазрешенныеТеги.Получить(Тег);
    Если СоответствиеАтрибутов = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат СоответствиеАтрибутов.Получить(Атрибут) <> Неопределено;

КонецФункции

// Проверяет, надо ли удалять тег вместе с содержимым.
//
// Параметры:
//   Имя - Строка - имя тега (нижний регистр)
//
// Возвращаемое значение:
//   Булево
Функция ЭтоТегСОпаснымСодержимым(Знач Имя) Экспорт

    Возврат мТегиСОпаснымСодержимым.Получить(Имя) <> Неопределено;

КонецФункции

// Проверяет, разрешён ли протокол URL.
//
// Параметры:
//   Схема - Строка - схема без двоеточия (нижний регистр)
//
// Возвращаемое значение:
//   Булево
Функция ПротоколРазрешен(Знач Схема) Экспорт

    Возврат мРазрешенныеПротоколы.Получить(Схема) <> Неопределено;

КонецФункции

// Значение rel для внешних ссылок.
//
// Возвращаемое значение:
//   Строка - пустая строка, если rel добавлять не нужно
Функция RelВнешнихСсылок() Экспорт

    Возврат мRelВнешнихСсылок;

КонецФункции

Процедура ПриСозданииОбъекта()

    мРазрешенныеТеги = Новый Соответствие;
    мРазрешенныеПротоколы = Новый Соответствие;
    мRelВнешнихСсылок = "nofollow noopener";

    мРазрешенныеПротоколы.Вставить("http", Истина);
    мРазрешенныеПротоколы.Вставить("https", Истина);
    мРазрешенныеПротоколы.Вставить("mailto", Истина);

    // теги, удаляемые вместе с содержимым, — исполняемые, стилевые,
    // raw-text и foreign-content контейнеры
    мТегиСОпаснымСодержимым = Новый Соответствие;
    ОпасныеТеги = СтрРазделить(
        "script,style,iframe,frame,frameset,object,embed,applet,form,button,select,option,"
        + "textarea,svg,math,template,xmp,noembed,noframes,noscript,title,head,marquee",
        ",", Ложь);
    Для Каждого Тег Из ОпасныеТеги Цикл
        мТегиСОпаснымСодержимым.Вставить(Тег, Истина);
    КонецЦикла;

КонецПроцедуры
