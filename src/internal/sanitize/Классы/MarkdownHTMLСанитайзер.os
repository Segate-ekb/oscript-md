// MarkdownHTMLСанитайзер — фильтрует поток токенов MarkdownHTMLТокенизатора по
// настройкам-allowlist и собирает безопасный, максимально well-formed HTML.
// Рабочая лошадь фасада Markdown.ОчиститьHTML.
//
// Гарантии:
//   - в выводе встречаются только разрешённые теги и разрешённые атрибуты;
//   - значения атрибутов и текст всегда экранированы;
//   - URL в href/src проходят проверку протокола (обфускации раскодируются);
//   - незакрытые разрешённые теги закрываются, лишние закрытия отбрасываются;
//   - опасные теги (script, style, svg, ...) удаляются вместе с содержимым.

Перем мНастройки; // MarkdownНастройкиСанитизации

// Санитизирует HTML.
//
// Параметры:
//   HTML - Строка - недоверенный HTML
//
// Возвращаемое значение:
//   Строка - безопасный HTML
Функция Очистить(Знач HTML) Экспорт

    Если НЕ ЗначениеЗаполнено(HTML) Тогда
        Возврат "";
    КонецЕсли;

    // нулевые байты удаляются до разбора (как в браузерах)
    HTML = СтрЗаменить(HTML, Символ(0), "");

    Токенизатор = Новый MarkdownHTMLТокенизатор;
    Токены = Токенизатор.Токенизировать(HTML);

    Вывод = Новый Массив;
    СтекТегов = Новый Массив;

    Индекс = 0;
    Пока Индекс <= Токены.ВГраница() Цикл

        Токен = Токены[Индекс];

        Если Токен.Тип = "Текст" Тогда
            Вывод.Добавить(MarkdownHTMLЭкранирование.Экранировать(MarkdownHTMLЭкранирование.Раскодировать(Токен.Текст)));
        ИначеЕсли Токен.Тип = "Открытие" Тогда
            Если мНастройки.ЭтоТегСОпаснымСодержимым(Токен.Имя) Тогда
                Если НЕ Токен.СамоЗакрыт Тогда
                    Индекс = ИндексЗакрывающегоТокена(Токены, Индекс, Токен.Имя);
                КонецЕсли;
            ИначеЕсли мНастройки.ТегРазрешен(Токен.Имя) Тогда
                ВывестиРазрешенныйТег(Токен, Вывод, СтекТегов);
            КонецЕсли;
            // неразрешённый и неопасный тег выбрасывается, содержимое остаётся
        ИначеЕсли Токен.Тип = "Закрытие" Тогда
            ЗакрытьТег(Токен.Имя, Вывод, СтекТегов);
        КонецЕсли;

        Индекс = Индекс + 1;

    КонецЦикла;

    // закрыть всё, что осталось открытым
    Пока СтекТегов.Количество() > 0 Цикл
        Вывод.Добавить("</" + СтекТегов[СтекТегов.ВГраница()] + ">");
        СтекТегов.Удалить(СтекТегов.ВГраница());
    КонецЦикла;

    Возврат СтрСоединить(Вывод, "");

КонецФункции

#Область Служебные

Процедура ВывестиРазрешенныйТег(Знач Токен, Вывод, СтекТегов)

    Имя = Токен.Имя;
    Части = Новый Массив;
    Части.Добавить("<" + Имя);

    ОбработанныеАтрибуты = Новый Соответствие;
    ЕстьВнешняяСсылка = Ложь;
    ЕстьRel = Ложь;

    Для Каждого Атрибут Из Токен.Атрибуты Цикл

        // при дублировании атрибутов действует только первый (как в браузере)
        Если ОбработанныеАтрибуты.Получить(Атрибут.Имя) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;
        ОбработанныеАтрибуты.Вставить(Атрибут.Имя, Истина);

        Если НЕ мНастройки.АтрибутРазрешен(Имя, Атрибут.Имя) Тогда
            Продолжить;
        КонецЕсли;

        Значение = MarkdownHTMLЭкранирование.Раскодировать(Атрибут.Значение);

        Если Атрибут.Имя = "href" Или Атрибут.Имя = "src" Тогда
            Значение = БезопасныйURL(Значение);
            Если Значение = Неопределено Тогда
                Продолжить;
            КонецЕсли;
            Если Атрибут.Имя = "href" И ЭтоВнешняяСсылка(Значение) Тогда
                ЕстьВнешняяСсылка = Истина;
            КонецЕсли;
        ИначеЕсли Атрибут.Имя = "class" Тогда
            Если НЕ ЭтоЯзыковойКласс(Значение) Тогда
                Продолжить;
            КонецЕсли;
        ИначеЕсли Атрибут.Имя = "align" Тогда
            Значение = НРег(СокрЛП(Значение));
            Если Значение <> "left" И Значение <> "center" И Значение <> "right" Тогда
                Продолжить;
            КонецЕсли;
        ИначеЕсли Атрибут.Имя = "type" Тогда
            // единственный type, порождаемый markdown-рендером, — чекбокс списка задач;
            // прочие (image, file, password) в README делать нечего
            Значение = НРег(СокрЛП(Значение));
            Если Значение <> "checkbox" Тогда
                Продолжить;
            КонецЕсли;
        КонецЕсли;

        Если Атрибут.Имя = "rel" Тогда
            ЕстьRel = Истина;
        КонецЕсли;

        Части.Добавить(" " + Атрибут.Имя + "=""" + MarkdownHTMLЭкранирование.Экранировать(Значение) + """");

    КонецЦикла;

    Rel = мНастройки.RelВнешнихСсылок();
    Если Имя = "a" И ЕстьВнешняяСсылка И Rel <> "" И НЕ ЕстьRel Тогда
        Части.Добавить(" rel=""" + MarkdownHTMLЭкранирование.Экранировать(Rel) + """");
    КонецЕсли;

    Если ЭтоПустойЭлемент(Имя) Тогда
        Части.Добавить("/>");
        Вывод.Добавить(СтрСоединить(Части, ""));
    ИначеЕсли Токен.СамоЗакрыт Тогда
        // самозакрытый непустой элемент нормализуется в пару открытие+закрытие
        Части.Добавить("></" + Имя + ">");
        Вывод.Добавить(СтрСоединить(Части, ""));
    Иначе
        Части.Добавить(">");
        Вывод.Добавить(СтрСоединить(Части, ""));
        СтекТегов.Добавить(Имя);
    КонецЕсли;

КонецПроцедуры

Процедура ЗакрытьТег(Знач Имя, Вывод, СтекТегов)

    // найти ближайший одноимённый тег — сверху стека вниз, с ранним выходом:
    // типичный </x> закрывает ближайший открытый <x> (обычно вершину — O(1))
    ПозицияВСтеке = -1;
    Индекс = СтекТегов.ВГраница();
    Пока Индекс >= 0 Цикл
        Если СтекТегов[Индекс] = Имя Тогда
            ПозицияВСтеке = Индекс;
            Прервать;
        КонецЕсли;
        Индекс = Индекс - 1;
    КонецЦикла;

    Если ПозицияВСтеке = -1 Тогда
        Возврат;
    КонецЕсли;

    // закрыть все вложенные и сам тег
    Пока СтекТегов.ВГраница() >= ПозицияВСтеке Цикл
        Вывод.Добавить("</" + СтекТегов[СтекТегов.ВГраница()] + ">");
        СтекТегов.Удалить(СтекТегов.ВГраница());
    КонецЦикла;

КонецПроцедуры

Функция ИндексЗакрывающегоТокена(Знач Токены, Знач ИндексОткрытия, Знач Имя)

    // пропустить всё содержимое опасного тега до парного закрытия;
    // закрытия нет — до конца (fail-closed: лучше удалить лишнее)
    Глубина = 1;
    Индекс = ИндексОткрытия + 1;

    Пока Индекс <= Токены.ВГраница() Цикл
        Токен = Токены[Индекс];
        Если Токен.Тип = "Открытие" И Токен.Имя = Имя И НЕ Токен.СамоЗакрыт Тогда
            Глубина = Глубина + 1;
        ИначеЕсли Токен.Тип = "Закрытие" И Токен.Имя = Имя Тогда
            Глубина = Глубина - 1;
            Если Глубина = 0 Тогда
                Возврат Индекс;
            КонецЕсли;
        КонецЕсли;
        Индекс = Индекс + 1;
    КонецЦикла;

    Возврат Токены.ВГраница();

КонецФункции

Функция БезопасныйURL(Знач Значение)

    Значение = УдалитьУправляющиеИНевидимые(Значение);
    Значение = СокрЛП(Значение);

    Если Значение = "" Тогда
        Возврат "";
    КонецЕсли;

    ПозицияДвоеточия = СтрНайти(Значение, ":");
    Если ПозицияДвоеточия = 0 Тогда
        Возврат Значение; // относительный URL
    КонецЕсли;

    // двоеточие после начала пути/запроса/якоря — не схема
    Разделители = СтрРазделить("/,?,#", ",", Ложь);
    Для Каждого Разделитель Из Разделители Цикл
        Позиция = СтрНайти(Значение, Разделитель);
        Если Позиция > 0 И Позиция < ПозицияДвоеточия Тогда
            Возврат Значение; // относительный URL
        КонецЕсли;
    КонецЦикла;

    Схема = НРег(Лев(Значение, ПозицияДвоеточия - 1));
    Если НЕ ЭтоКорректнаяСхема(Схема) Тогда
        Возврат Неопределено; // обфускация схемы — атрибут удаляется
    КонецЕсли;

    Если мНастройки.ПротоколРазрешен(Схема) Тогда
        Возврат Значение;
    КонецЕсли;

    Возврат Неопределено;

КонецФункции

Функция ЭтоКорректнаяСхема(Знач Схема)

    Если Схема = "" Тогда
        Возврат Ложь;
    КонецЕсли;

    Буквы = "abcdefghijklmnopqrstuvwxyz";
    Если СтрНайти(Буквы, Лев(Схема, 1)) = 0 Тогда
        Возврат Ложь;
    КонецЕсли;

    Допустимые = Буквы + "0123456789+.-";
    Для Индекс = 2 По СтрДлина(Схема) Цикл
        Если СтрНайти(Допустимые, Сред(Схема, Индекс, 1)) = 0 Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;

    Возврат Истина;

КонецФункции

Функция ЭтоВнешняяСсылка(Знач Значение)

    Значение = НРег(Значение);
    Возврат СтрНачинаетсяС(Значение, "http://")
        Или СтрНачинаетсяС(Значение, "https://")
        Или СтрНачинаетсяС(Значение, "//");

КонецФункции

Функция ЭтоЯзыковойКласс(Знач Значение)

    Значение = СокрЛП(Значение);
    Если НЕ СтрНачинаетсяС(Значение, "language-") Тогда
        Возврат Ложь;
    КонецЕсли;

    Остаток = Сред(Значение, СтрДлина("language-") + 1);
    Если Остаток = "" Тогда
        Возврат Ложь;
    КонецЕсли;

    Допустимые = "abcdefghijklmnopqrstuvwxyz0123456789+#-_.";
    Для Индекс = 1 По СтрДлина(Остаток) Цикл
        Если СтрНайти(Допустимые, НРег(Сред(Остаток, Индекс, 1))) = 0 Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;

    Возврат Истина;

КонецФункции

Функция ЭтоПустойЭлемент(Знач Имя)

    Возврат Имя = "br" Или Имя = "hr" Или Имя = "img" Или Имя = "input";

КонецФункции

Функция УдалитьУправляющиеИНевидимые(Знач Значение)

    Результат = Новый Массив;
    Для Индекс = 1 По СтрДлина(Значение) Цикл
        Знак = Сред(Значение, Индекс, 1);
        Код = КодСимвола(Знак);
        Если Код < 32 Тогда
            Продолжить; // управляющие: таб, перевод строки и пр.
        КонецЕсли;
        Если (Код >= 8203 И Код <= 8207)      // zero-width, LRM/RLM
            Или (Код >= 8232 И Код <= 8238)   // разделители строк, LRE/RLE/PDF/LRO/RLO
            Или (Код >= 8294 И Код <= 8297)   // LRI/RLI/FSI/PDI
            Или Код = 65279 Тогда             // BOM/ZWNBSP
            Продолжить;
        КонецЕсли;
        Результат.Добавить(Знак);
    КонецЦикла;

    Возврат СтрСоединить(Результат, "");

КонецФункции

Процедура ПриСозданииОбъекта(Настройки)

    Если ТипЗнч(Настройки) <> Тип("MarkdownНастройкиСанитизации") Тогда
        ВызватьИсключение "MarkdownHTMLСанитайзер требует объект MarkdownНастройкиСанитизации";
    КонецЕсли;
    мНастройки = Настройки;

КонецПроцедуры

#КонецОбласти
