// MarkdownHTMLТокенизатор — разбирает HTML-строку на поток токенов для санитайзера.
//
// Токенизатор устойчив к малформед-HTML и повторяет ключевые решения
// HTML5-парсера: "<" не перед буквой — обычный текст; комментарии,
// CDATA-секции, доктайпы и инструкции обработки пропускаются целиком;
// незакрытая кавычка значения атрибута поглощает текст до конца строки.
//
// Виды токенов (Структура):
//   Текст     - Тип = "Текст", Текст (сырой, сущности не раскодированы)
//   Открытие  - Тип = "Открытие", Имя (нижний регистр),
//               Атрибуты (Массив Структур: Имя, Значение — сырое), СамоЗакрыт (Булево)
//   Закрытие  - Тип = "Закрытие", Имя (нижний регистр)

// Разбирает HTML на массив токенов.
//
// Параметры:
//   HTML - Строка - исходный HTML
//
// Возвращаемое значение:
//   Массив - массив структур-токенов (см. описание модуля)
Функция Токенизировать(Знач HTML) Экспорт

    Токены = Новый Массив;
    Длина = СтрДлина(HTML);
    Позиция = 1;

    Пока Позиция <= Длина Цикл

        ПозицияТега = СтрНайти(HTML, "<", НаправлениеПоиска.СНачала, Позиция);

        Если ПозицияТега = 0 Тогда
            ДобавитьТекст(Токены, Сред(HTML, Позиция));
            Прервать;
        КонецЕсли;

        Если ПозицияТега > Позиция Тогда
            ДобавитьТекст(Токены, Сред(HTML, Позиция, ПозицияТега - Позиция));
        КонецЕсли;

        Следующий = Сред(HTML, ПозицияТега + 1, 1);

        Если Следующий = "!" Тогда
            Позиция = ПропуститьДекларацию(HTML, ПозицияТега, Длина);
        ИначеЕсли Следующий = "?" Тогда
            Позиция = ПропуститьДоСимвола(HTML, ПозицияТега + 2, Длина, ">");
        ИначеЕсли Следующий = "/" Тогда
            Если ЭтоБуква(Сред(HTML, ПозицияТега + 2, 1)) Тогда
                Позиция = РазобратьЗакрывающийТег(HTML, ПозицияТега, Длина, Токены);
            Иначе
                // "</>" и "</ ...>" — bogus comment, пропустить до ">"
                Позиция = ПропуститьДоСимвола(HTML, ПозицияТега + 2, Длина, ">");
            КонецЕсли;
        ИначеЕсли ЭтоБуква(Следующий) Тогда
            Позиция = РазобратьОткрывающийТег(HTML, ПозицияТега, Длина, Токены);
        Иначе
            // "<" не начинает тег — это обычный текст
            ДобавитьТекст(Токены, "<");
            Позиция = ПозицияТега + 1;
        КонецЕсли;

    КонецЦикла;

    Возврат Токены;

КонецФункции

#Область Служебные

Процедура ДобавитьТекст(Токены, Знач Текст)

    Если Текст = "" Тогда
        Возврат;
    КонецЕсли;
    Токены.Добавить(Новый Структура("Тип, Текст", "Текст", Текст));

КонецПроцедуры

Функция РазобратьОткрывающийТег(Знач Текст, Знач Позиция, Знач Длина, Токены)

    // Позиция указывает на "<", за ним — буква
    Текущая = Позиция + 1;
    НачалоИмени = Текущая;
    Пока Текущая <= Длина И ЭтоСимволИмени(Сред(Текст, Текущая, 1)) Цикл
        Текущая = Текущая + 1;
    КонецЦикла;
    Имя = НРег(Сред(Текст, НачалоИмени, Текущая - НачалоИмени));

    Атрибуты = Новый Массив;
    СамоЗакрыт = Ложь;

    Пока Истина Цикл

        Пока Текущая <= Длина И ЭтоПробел(Сред(Текст, Текущая, 1)) Цикл
            Текущая = Текущая + 1;
        КонецЦикла;

        Если Текущая > Длина Тогда
            Прервать; // незакрытый тег на конце строки
        КонецЕсли;

        Знак = Сред(Текст, Текущая, 1);

        Если Знак = ">" Тогда
            Текущая = Текущая + 1;
            Прервать;
        ИначеЕсли Знак = "/" Тогда
            Если Сред(Текст, Текущая + 1, 1) = ">" Тогда
                СамоЗакрыт = Истина;
                Текущая = Текущая + 2;
                Прервать;
            КонецЕсли;
            Текущая = Текущая + 1;
            Продолжить;
        КонецЕсли;

        Текущая = РазобратьАтрибут(Текст, Текущая, Длина, Атрибуты);

    КонецЦикла;

    Токены.Добавить(Новый Структура("Тип, Имя, Атрибуты, СамоЗакрыт",
        "Открытие", Имя, Атрибуты, СамоЗакрыт));

    Возврат Текущая;

КонецФункции

Функция РазобратьАтрибут(Знач Текст, Знач Позиция, Знач Длина, Атрибуты)

    // имя атрибута — до пробела, "=", ">" или "/"
    Текущая = Позиция;
    НачалоИмени = Текущая;
    Пока Текущая <= Длина Цикл
        Знак = Сред(Текст, Текущая, 1);
        Если ЭтоПробел(Знак) Или Знак = "=" Или Знак = ">" Или Знак = "/" Тогда
            Прервать;
        КонецЕсли;
        Текущая = Текущая + 1;
    КонецЦикла;
    ИмяАтрибута = НРег(Сред(Текст, НачалоИмени, Текущая - НачалоИмени));

    Пока Текущая <= Длина И ЭтоПробел(Сред(Текст, Текущая, 1)) Цикл
        Текущая = Текущая + 1;
    КонецЦикла;

    Значение = "";
    Если Сред(Текст, Текущая, 1) = "=" Тогда

        Текущая = Текущая + 1;
        Пока Текущая <= Длина И ЭтоПробел(Сред(Текст, Текущая, 1)) Цикл
            Текущая = Текущая + 1;
        КонецЦикла;

        Кавычка = Сред(Текст, Текущая, 1);
        Если Кавычка = """" Или Кавычка = "'" Тогда
            ПозицияКонца = 0;
            Если Текущая < Длина Тогда
                ПозицияКонца = СтрНайти(Текст, Кавычка, НаправлениеПоиска.СНачала, Текущая + 1);
            КонецЕсли;
            Если ПозицияКонца = 0 Тогда
                // незакрытая кавычка — значение до конца строки (как в браузере)
                Значение = Сред(Текст, Текущая + 1);
                Текущая = Длина + 1;
            Иначе
                Значение = Сред(Текст, Текущая + 1, ПозицияКонца - Текущая - 1);
                Текущая = ПозицияКонца + 1;
            КонецЕсли;
        Иначе
            НачалоЗначения = Текущая;
            Пока Текущая <= Длина Цикл
                Знак = Сред(Текст, Текущая, 1);
                Если ЭтоПробел(Знак) Или Знак = ">" Тогда
                    Прервать;
                КонецЕсли;
                Текущая = Текущая + 1;
            КонецЦикла;
            Значение = Сред(Текст, НачалоЗначения, Текущая - НачалоЗначения);
        КонецЕсли;

    КонецЕсли;

    Если ИмяАтрибута <> "" Тогда
        Атрибуты.Добавить(Новый Структура("Имя, Значение", ИмяАтрибута, Значение));
    КонецЕсли;

    Возврат Текущая;

КонецФункции

Функция РазобратьЗакрывающийТег(Знач Текст, Знач Позиция, Знач Длина, Токены)

    // Позиция указывает на "<", далее "/" и буква
    Текущая = Позиция + 2;
    НачалоИмени = Текущая;
    Пока Текущая <= Длина И ЭтоСимволИмени(Сред(Текст, Текущая, 1)) Цикл
        Текущая = Текущая + 1;
    КонецЦикла;
    Имя = НРег(Сред(Текст, НачалоИмени, Текущая - НачалоИмени));

    Токены.Добавить(Новый Структура("Тип, Имя", "Закрытие", Имя));

    // остаток закрывающего тега (в т.ч. ошибочные атрибуты) — пропустить
    Возврат ПропуститьДоСимвола(Текст, Текущая, Длина, ">");

КонецФункции

Функция ПропуститьДекларацию(Знач Текст, Знач Позиция, Знач Длина)

    // Позиция указывает на "<", за ним "!"
    Если Сред(Текст, Позиция, 4) = "<!--" Тогда
        // комментарий (включая conditional comments) — до "-->"
        ПозицияКонца = НайтиНачинаяС(Текст, "-->", Позиция + 4, Длина);
        Возврат ?(ПозицияКонца = 0, Длина + 1, ПозицияКонца + 3);
    КонецЕсли;

    Если ВРег(Сред(Текст, Позиция, 9)) = "<![CDATA[" Тогда
        ПозицияКонца = НайтиНачинаяС(Текст, "]]>", Позиция + 9, Длина);
        Возврат ?(ПозицияКонца = 0, Длина + 1, ПозицияКонца + 3);
    КонецЕсли;

    // доктайп и прочие декларации — до первого ">"
    Возврат ПропуститьДоСимвола(Текст, Позиция + 2, Длина, ">");

КонецФункции

Функция ПропуститьДоСимвола(Знач Текст, Знач Позиция, Знач Длина, Знач Искомый)

    Если Позиция > Длина Тогда
        Возврат Длина + 1;
    КонецЕсли;

    ПозицияКонца = СтрНайти(Текст, Искомый, НаправлениеПоиска.СНачала, Позиция);
    Возврат ?(ПозицияКонца = 0, Длина + 1, ПозицияКонца + СтрДлина(Искомый));

КонецФункции

Функция НайтиНачинаяС(Знач Текст, Знач Искомый, Знач Позиция, Знач Длина)

    Если Позиция > Длина Тогда
        Возврат 0;
    КонецЕсли;
    Возврат СтрНайти(Текст, Искомый, НаправлениеПоиска.СНачала, Позиция);

КонецФункции

Функция ЭтоБуква(Знач Знак)

    Возврат Знак <> "" И СтрНайти("abcdefghijklmnopqrstuvwxyz", НРег(Знак)) > 0;

КонецФункции

Функция ЭтоСимволИмени(Знач Знак)

    Возврат Знак <> "" И СтрНайти("abcdefghijklmnopqrstuvwxyz0123456789-", НРег(Знак)) > 0;

КонецФункции

Функция ЭтоПробел(Знач Знак)

    Возврат Знак = " " Или Знак = Символы.Таб Или Знак = Символы.ПС
        Или Знак = Символы.ВК Или Знак = Символ(12);

КонецФункции

#КонецОбласти
